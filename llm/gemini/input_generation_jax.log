class CustomTensorList:
    def __init__(self, tensors):
        self.tensors = tensors
    @property
    def shape(self):
        return (len(self.tensors),)
    @property
    def size(self):
        return len(self.tensors)
    def min(self, *args, **kwargs):
        return min(float(np.min(t)) for t in self.tensors)
    def max(self, *args, **kwargs):
        return max(float(np.max(t)) for t in self.tensors)
    def __iter__(self):
        return iter(self.tensors)
    def __len__(self):
