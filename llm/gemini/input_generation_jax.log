    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 5: 3D tensor, float64, random values in [-1, 1]
    x = np.random.uniform(-1.0, 1.0, size=(2, 3, 4)).astype(np.float64)
    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 6: 1D tensor, int32 (containing -1, 0, 1)
