    list_of_inputs.append({"x": ArrayTuple((1e5, 1e10, 1e15))})

    # Input 10: Mixed integer-like float values
    list_of_inputs.append({"x": ArrayTuple((2.0, 3.0, 4.0))})

    return list_of_inputs

