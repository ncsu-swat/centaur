import numpy as np
import copy

class TensorListArray(np.ndarray):
    def __new__(cls, input_list):
        obj = np.empty(len(input_list), dtype=object).view(cls)
        for i, x in enumerate(input_list):
            obj[i] = x
        return obj

    def min(self, *args, **kwargs):
        return 0

    def max(self, *args, **kwargs):
        return 0

def make_tensor_list(*arrays):
    return TensorListArray(arrays)

def broadcast_arrays_inputs():
    list_of_inputs = []

    # Input 1: 1D array and a scalar
    a = np.array([1, 2, 3], dtype=np.int32)
    b = np.array(5, dtype=np.int32)
    input_dict = {"args": make_tensor_list(a, b)}
    list_of_inputs.append(copy.deepcopy(input_dict))

