def right_shift_inputs():
    list_of_inputs = []

    # Input 1: Simple 1D arrays, uint8
    x1 = np.array([2, 4, 8, 16, 32], dtype=np.uint8)
    x2 = np.array([1, 1, 2, 2, 3], dtype=np.uint8)
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 2: 2D arrays with uint16 and int32 shift amounts
    x1 = np.array([[10, 20], [30, 40]], dtype=np.uint16)
    x2 = np.array([[1, 2], [3, 4]], dtype=np.int32)
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 3: Broadcasting 1D array with a scalar-like 0D array
    x1 = np.array([128, 64, 32], dtype=np.uint32)
    x2 = np.array(2, dtype=np.int32)
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 4: Broadcasting 3D array and 1D array
    x1 = np.ones((2, 3, 4), dtype=np.uint8) * 120
    x2 = np.array([1, 2, 3, 4], dtype=np.int8)
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 5: Large uint64 elements with large shift values
    x1 = np.array([2**60, 2**61, 2**62], dtype=np.uint64)
    x2 = np.array([10, 20, 30], dtype=np.uint32)
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 6: 0D arrays (scalars)
    x1 = np.array(255, dtype=np.uint8)
    x2 = np.array(4, dtype=np.uint8)
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 7: Higher-dimensional 4D arrays, uint8
    x1 = np.random.randint(0, 256, size=(2, 2, 2, 2), dtype=np.uint8)
    x2 = np.random.randint(0, 8, size=(2, 2, 2, 2), dtype=np.int32)
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 8: Mixed types (uint32 x1 and uint16 x2), broadcasting row-wise
    x1 = np.array([[1024, 2048, 4096]], dtype=np.uint32)
    x2 = np.array([[2], [4]], dtype=np.uint16)  # (2, 1) broadcasted with (1, 3)
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 9: Zero shifts (should keep original values)
    x1 = np.array([5, 10, 15], dtype=np.uint8)
    x2 = np.array([0, 0, 0], dtype=np.int32)
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 10: Boundary values - shifting to 0
    x1 = np.array([1, 3, 7], dtype=np.uint8)
    x2 = np.array([4, 4, 4], dtype=np.uint8)  # Shifts greater than bit width for some
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 11: Empty arrays
    x1 = np.array([], dtype=np.uint8).reshape(0, 5)
    x2 = np.array([], dtype=np.int32).reshape(0, 5)
    list_of_inputs.append({"x1": x1, "x2": x2})

    return list_of_inputs

