    operand = np.random.randn(3, 1).astype(np.float32)
    shape = (2, 3, 4)
    broadcast_dimensions = (1, 2)
    list_of_inputs.append({
        "operand": operand,
        "shape": shape,
        "broadcast_dimensions": broadcast_dimensions
    })

    # Input 4: 2D to 3D with implicit transpose
    operand = np.random.randn(3, 1).astype(np.float32)
