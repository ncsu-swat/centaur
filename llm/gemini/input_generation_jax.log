    # Input 4: Broadcasting a scalar-like 1D array to a 2D array, uint8
    x = np.array([[10, 20, 30], [40, 50, 60]], dtype=np.uint8)
    y = np.array([1], dtype=np.uint8)
    list_of_inputs.append({"x": copy.deepcopy(x), "y": copy.deepcopy(y)})

    # Input 5: Negative values in x, int8, with small shifts
    x = np.array([-1, -2, -3, -4], dtype=np.int8)
