    list_of_inputs.append({"x1": copy.deepcopy(x1), "x2": copy.deepcopy(x2)})

    # Input 7: 3D float32 arrays
    x1 = np.random.uniform(0.1, 5.0, size=(2, 3, 4)).astype(np.float32)
