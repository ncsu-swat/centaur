    x = CustomList([np.float32(-1.0), np.float32(2.0), np.float32(-3.0)])
    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 4: List of numpy int16 scalars
    x = CustomList([np.int16(-10), np.int16(20), np.int16(-30)])
    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 5: 2D nested list of integers
    x = CustomList([CustomList([-1, 2]), CustomList([-3, 4])])
    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 6: 2D nested list of floats
    x = CustomList([CustomList([-1.2, 2.3]), CustomList([-3.4, 4.5])])
    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 7: List of complex numbers
    x = CustomList([complex(-1, 2), complex(3, -4)])
    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 8: List of numpy complex64 scalars
    x = CustomList([np.complex64(-1 + 2j), np.complex64(3 - 4j)])
    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 9: 3D nested list of integers
