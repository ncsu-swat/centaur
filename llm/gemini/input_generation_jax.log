    x2 = np.array([7, 14, 21], dtype=np.int8)
    list_of_inputs.append({"x1": x1, "x2": x2})

    # Input 10: Prime numbers (resulting in gcd of 1)
    x1 = np.array([13, 17, 19], dtype=np.int32)
    x2 = np.array([23, 29, 31], dtype=np.int32)
