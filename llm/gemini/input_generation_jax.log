import numpy as np
import copy

class TensorList(list):
    @property
    def shape(self):
        return (len(self),)

    @property
    def dtype(self):
        return self[0].dtype if len(self) > 0 else np.float32

    @property
    def ndim(self):
        return 1

    def __deepcopy__(self, memo):
        return TensorList([copy.deepcopy(x, memo) for x in self])

