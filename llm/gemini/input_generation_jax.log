    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 5: 3D array of floats using random values
    x = np.random.uniform(-360.0, 360.0, (2, 3, 4)).astype(np.float32)
    list_of_inputs.append({"x": copy.deepcopy(x)})

