    a = np.random.randn(3, 1).astype(np.float32)
    b = np.random.randn(1, 4).astype(np.float32)
    input_dict = {"args": make_tensor_list(a, b)}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 4: 3D array and a 2D array
    a = np.random.randn(2, 3, 4).astype(np.float32)
    b = np.random.randn(3, 4).astype(np.float32)
    input_dict = {"args": make_tensor_list(a, b)}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 5: Three arrays with negative float64 values
    a = np.array([[[-1.5, -2.5], [3.5, 4.5]]], dtype=np.float64)
    b = np.array([-10.0, -20.0], dtype=np.float64)
    c = np.array(100.0, dtype=np.float64)
    input_dict = {"args": make_tensor_list(a, b, c)}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 6: Boolean arrays
    a = np.array([[True, False], [False, True]], dtype=np.bool_)
    b = np.array([True, True], dtype=np.bool_)
    input_dict = {"args": make_tensor_list(a, b)}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 7: Integer arrays with negative values and differing shapes
    a = np.array([[-1, -2, -3], [4, 5, 6]], dtype=np.int32)
    b = np.array([-10], dtype=np.int32)
    input_dict = {"args": make_tensor_list(a, b)}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 8: High-dimensional broadcasting
    a = np.random.randn(1, 2, 1, 4).astype(np.float32)
