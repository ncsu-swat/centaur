import numpy as np
import copy
import jax
from jax.sharding import Mesh, PartitionSpec

def zeros_inputs():
    # Set up global mesh context to enable PartitionSpec usage
    devices = np.array(jax.devices())
    mesh = Mesh(devices, ('x',))
    jax.set_mesh(mesh)

    list_of_inputs = []

    # Input 1: 1D float32 array, empty sharding (replicated)
    input_dict = {
        "shape": (4,),
        "dtype": np.dtype('float32'),
        "out_sharding": PartitionSpec()
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 2: 2D int32 array, sharded on x
    input_dict = {
        "shape": (2, 3),
        "dtype": np.dtype('int32'),
        "out_sharding": PartitionSpec('x', 'x')
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 3: 3D float64 array, sharded on x
    input_dict = {
        "shape": (8, 8, 8),
        "dtype": np.dtype('float64'),
        "out_sharding": PartitionSpec('x', 'x', 'x')
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 4: 2D boolean array with x sharding
    input_dict = {
        "shape": (10, 5),
        "dtype": np.dtype('bool'),
        "out_sharding": PartitionSpec('x', 'x')
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 5: 2D complex64 array, empty sharding
    input_dict = {
        "shape": (1, 100),
        "dtype": np.dtype('complex64'),
        "out_sharding": PartitionSpec()
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 6: 2D uint32 array sharded on x
    input_dict = {
        "shape": (16, 16),
        "dtype": np.dtype('uint32'),
        "out_sharding": PartitionSpec('x', 'x')
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 7: 4D float16 array sharded on x
    input_dict = {
        "shape": (3, 3, 3, 3),
        "dtype": np.dtype('float16'),
        "out_sharding": PartitionSpec('x', 'x', 'x', 'x')
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 8: 1D int64 array with x sharding
    input_dict = {
        "shape": (5,),
        "dtype": np.dtype('int64'),
        "out_sharding": PartitionSpec('x',)
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 9: 3D uint8 array sharded on x
    input_dict = {
        "shape": (2, 4, 8),
        "dtype": np.dtype('uint8'),
        "out_sharding": PartitionSpec('x', 'x', 'x')
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 10: 2D int16 array, empty sharding
    input_dict = {
        "shape": (12, 12),
        "dtype": np.dtype('int16'),
        "out_sharding": PartitionSpec()
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    return list_of_inputs

generated_inputs["jax.numpy.zeros_2"] = zeros_inputs()
