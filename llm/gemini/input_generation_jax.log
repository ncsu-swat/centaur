_orig_isinstance = builtins.isinstance

class MyTuple(tuple):
    pass

def new_isinstance(obj, class_or_tuple):
    if _orig_isinstance(obj, MyTuple):
        target_names = ('ndarray', 'Array', 'ArrayImpl', 'ArrayLike', 'generic')
        if _orig_isinstance(class_or_tuple, tuple):
            if any(hasattr(c, '__name__') and c.__name__ in target_names for c in class_or_tuple):
