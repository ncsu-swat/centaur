    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 10: 1D float16 array
    x = np.array([-1.5, 0.0, 1.5], dtype=np.float16)
    list_of_inputs.append({"x": copy.deepcopy(x)})

    return list_of_inputs

