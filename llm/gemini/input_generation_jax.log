import numpy as np
import copy
import jax
from jax.sharding import Mesh, PartitionSpec

def zeros_inputs():
    # Set up global mesh context to enable PartitionSpec usage
    devices = np.array(jax.devices())
    mesh = Mesh(devices, ('x',))
    jax.set_mesh(mesh)

    list_of_inputs = []

    # Input 1: 1D float32 array
    input_dict = {
        "shape": (4,),
        "dtype": np.dtype('float32'),
        "out_sharding": PartitionSpec(None,)
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 2: 2D int32 array
    input_dict = {
        "shape": (2, 3),
        "dtype": np.dtype('int32'),
        "out_sharding": PartitionSpec(None, None)
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 3: 3D float64 array
    input_dict = {
        "shape": (8, 8, 8),
        "dtype": np.dtype('float64'),
        "out_sharding": PartitionSpec(None, None, None)
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 4: 2D boolean array with named sharding
    input_dict = {
        "shape": (10, 5),
        "dtype": np.dtype('bool'),
        "out_sharding": PartitionSpec('x', None)
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 5: 2D complex64 array
    input_dict = {
        "shape": (1, 100),
        "dtype": np.dtype('complex64'),
        "out_sharding": PartitionSpec(None, 'x')
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 6: 2D uint32 array with x-axis sharding
    input_dict = {
        "shape": (16, 16),
        "dtype": np.dtype('uint32'),
        "out_sharding": PartitionSpec('x', None)
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 7: 4D float16 array
    input_dict = {
        "shape": (3, 3, 3, 3),
        "dtype": np.dtype('float16'),
        "out_sharding": PartitionSpec(None, None, None, None)
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 8: 1D int64 array with named sharding
    input_dict = {
        "shape": (5,),
        "dtype": np.dtype('int64'),
        "out_sharding": PartitionSpec('x',)
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 9: 3D uint8 array with mixed sharding
    input_dict = {
        "shape": (2, 4, 8),
        "dtype": np.dtype('uint8'),
        "out_sharding": PartitionSpec('x', None, None)
    }
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 10: 2D int16 array with y-equivalent sharding on x
    input_dict = {
        "shape": (12, 12),
        "dtype": np.dtype('int16'),
        "out_sharding": PartitionSpec(None, 'x')
    }
