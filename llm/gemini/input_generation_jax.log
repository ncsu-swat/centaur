import copy

def tanh_inputs():
    list_of_inputs = []

    # Input 1: 1D array of float32 with positive, negative, and zero values
    x = np.array([-2.0, -1.0, 0.0, 1.0, 2.0], dtype=np.float32)
    list_of_inputs.append({"x": copy.deepcopy(x)})

    # Input 2: 2D array of float32 (matrix)
