import numpy as np
import jax
import copy

# Dummy scaled_matmul implementation to bypass CPU limitation of cuDNN primitive
def dummy_scaled_matmul(lhs, rhs, lhs_scale, rhs_scale, bias=None, transpose_lhs=False, transpose_rhs=False, *args, **kwargs):
    import jax.numpy as jnp
    lhs_f = lhs.astype(jnp.float32)
    rhs_f = rhs.astype(jnp.float32)
    
    if transpose_lhs:
        lhs_f = lhs_f.T
    if transpose_rhs:
        rhs_f = rhs_f.T
        
    res = jnp.matmul(lhs_f, rhs_f)
    if bias is not None:
        res = res + bias.astype(jnp.float32)
    return res.astype(lhs.dtype)

