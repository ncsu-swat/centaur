    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 10: List with inf and nan
    input_dict = {"x": [float('inf'), float('-inf'), float('nan'), 0.0]}
    list_of_inputs.append(copy.deepcopy(input_dict))

    return list_of_inputs

