import numpy as np
import copy

class ScalarTuple(tuple):
    @property
    def shape(self):
        return ()

    def __array__(self, dtype=None, context=None):
        return np.array(self[0], dtype=dtype)

    def __float__(self):
        return float(self[0])

    def __int__(self):
        return int(self[0])

    def __complex__(self):
        return complex(self[0])

    def __bool__(self):
        return bool(self[0])

def isreal_inputs():
    list_of_inputs = []

    values = [
        1,
        -2.5,
        3+4j,
        5+0j,
        True,
        False,
        0.0,
        -0j,
        1e10,
        -9999
    ]

    for val in values:
        input_dict = {"x": ScalarTuple((val,))}
        list_of_inputs.append(copy.deepcopy(input_dict))

    return list_of_inputs

