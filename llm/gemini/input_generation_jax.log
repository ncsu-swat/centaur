import numpy as np
import copy
import jax.numpy as jnp

class JaxTuple(tuple):
    def __jax_array__(self):
        return jnp.array(list(self))
    
    def __array__(self, dtype=None):
        return np.array(list(self), dtype=dtype)
    
    def __deepcopy__(self, memo):
        return JaxTuple(copy.deepcopy(item, memo) for item in self)
    
    def __reduce__(self):
        return (JaxTuple, (list(self),))

def expm1_inputs():
