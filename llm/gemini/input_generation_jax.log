                    return original_is_arraylike(x)
                jax_util.is_arraylike = patched_is_arraylike
                
                try:
                    import jax._src.util as jax_src_util
                    if hasattr(jax_src_util, 'is_arraylike'):
                        jax_src_util.is_arraylike = patched_is_arraylike
                except Exception:
