import numpy as np
import copy
import jax
import jax.numpy as jnp

class ArrayTuple(tuple):
    def __jax_array__(self):
        def to_list(t):
            if isinstance(t, tuple):
                return [to_list(x) for x in t]
            return t
        return jnp.array(to_list(self))

def arccosh_inputs():
    list_of_inputs = []

    # Input 1: Simple float tuple
