    value = 0.5
    out = torch.tensor().numpy()

    input_dict = {
        "input": input,
        "tensor1": tensor1,
        "tensor2": tensor2,
        "value": value
    }
    
    list_of_inputs.append(copy.deepcopy(input_dict))

    # 3 or more inputs like this
    
