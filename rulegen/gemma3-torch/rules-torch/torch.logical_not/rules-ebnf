Rule 4 (out tensor must have the same shape as input tensor)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 7 (input tensor must be a tensor)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 9 (input tensor elements are interpreted as booleans)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1) - 1] : v_1[i] = 0 ∨ v_1[i] ≠ 0
>>
Rule 16 (Zero elements in input are interpreted as False, non-zero as True)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1) - 1] : (v_1[i] = 0 ∨ v_1[i] ≠ 0)
>>
Rule 25 (zero elements treated as false, non-zero as true)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1) - 1] : (v_1[i] = 0) ∨ (v_1[i] ≠ 0)
