>>
Rule 1 (in_channels must be a positive integer)
{in_channels : int} |= in_channels > 0
>>
Rule 2 (out_channels must be a positive integer)
{out_channels : int} |= out_channels > 0
>>
Rule 3 (kernel_size must be a positive integer or tuple of positive integers)
{kernel_size : int ⊎ tuple(int)} |= if ndim(kernel_size) = 1 then kernel_size > 0 else (ndim(kernel_size) = 2 ∧ ∀i ∈ [0, kernel_size.len - 1] : kernel_size[i] > 0)
>>
Rule 4 (stride must be a positive integer or tuple of positive integers)
{stride : int ⊎ tuple(int)} |= if ndim(stride) = 1 then stride > 0 else (ndim(stride) = 2 ∧ ∀i ∈ [0, stride.len - 1] : stride[i] > 0)
>>
Rule 5 (padding must be a non-negative integer or tuple of non-negative integers)
{padding : int ⊎ tuple(int)} |= if ndim(padding) = 1 then padding ≥ 0 else (ndim(padding) = 2 ∧ ∀i ∈ [0, padding.len - 1] : padding[i] ≥ 0)
>>
Rule 6 (output_padding must be a non-negative integer or tuple of non-negative integers)
{output_padding : int ⊎ tuple(int)} |= if ndim(output_padding) = 1 then output_padding ≥ 0 else (ndim(output_padding) = 2 ∧ ∀i ∈ [0, output_padding.len - 1] : output_padding[i] ≥ 0)
>>
Rule 7 (groups must be a positive integer that divides both in_channels and out_channels)
{in_channels : int, out_channels : int, groups : int} |= groups > 0 ∧ in_channels % groups = 0 ∧ out_channels % groups = 0
>>
Rule 9 (dilation must be a positive integer or tuple of positive integers)
{dilation : int ⊎ tuple(int)} |= if ndim(dilation) = 1 then dilation > 0 else (ndim(dilation) = 2 ∧ ∀i ∈ [0, dilation.len - 1] : dilation[i] > 0)
>>
Rule 15 (kernel_size and stride have the same dimensionality)
{kernel_size : int ⊎ tuple(int), stride : int ⊎ tuple(int)} |= if ndim(kernel_size) = 1 then ndim(stride) = 1 else ndim(kernel_size) = ndim(stride)
>>
Rule 16 (kernel_size, stride and padding have the same dimensionality)
{kernel_size : int ⊎ tuple(int), stride : int ⊎ tuple(int), padding : int ⊎ tuple(int)} |= if ndim(kernel_size) = 1 then (ndim(stride) = 1 ∧ ndim(padding) = 1) else (ndim(kernel_size) = ndim(stride) ∧ ndim(kernel_size) = ndim(padding))
>>
Rule 17 (input tensor must have at least 4 dimensions)
{input : tensor} |= ndim(input) ≥ 4
>>
Rule 18 (groups must be 1 if padding_mode is not "constant")
{groups : int, padding_mode : str} |= if padding_mode ≠ "constant" then groups = 1 else True
>>
Rule 19 (if padding_mode is "constant", groups must be 1)
{groups : int, padding_mode : str} |= padding_mode = "constant" ∧ groups = 1
>>
Rule 20 (If output_size is not None, its length should be equal to the number of dimensions of the input)
{input : tensor, output_size : tuple(int)} |= ndim(input) = output_size.len
>>
Rule 21 (padding_mode must be "constant" to avoid ValueError)
{padding_mode : str} |= padding_mode = "constant"
>>
Rule 22 (bias must be a boolean value)
{bias : bool} |= bias = true ∨ bias = false
>>
Rule 29 (groups must be a positive integer)
{groups : int} |= groups > 0
>>
Rule 30 (in_channels must be greater than or equal to groups)
{in_channels : int, groups : int} |= in_channels ≥ groups
>>
Rule 31 (out_channels must be greater than or equal to groups)
{out_channels : int, groups : int} |= out_channels ≥ groups
>>
Rule 32 (in_channels and out_channels must both be divisible by groups)
{in_channels : int, out_channels : int, groups : int} |= in_channels % groups = 0 ∧ out_channels % groups = 0
>>
Rule 51 (dtype must be within the valid range of 0 to 12)
{dtype : dtype} |= dtype ≥ 0 ∧ dtype ≤ 12
