...   [0], [1, 2, 3, 4], [5, 6, 7],
...   [7, 8, 9, 10, 11], [13, 14, 15, 16, 19, 20], [21, 22]]

>>> dataset = tf.data.Dataset.from_generator(
...   lambda: elements, tf.int32, output_shapes=[None])

>>> dataset = dataset.apply(
...     tf.data.experimental.bucket_by_sequence_length(
