...         bucket_boundaries=[4, 7],
...         bucket_batch_sizes=[2, 2, 2],
...         pad_to_bucket_boundary=True,
...         padding_values=-1))

>>> for elem in dataset.as_numpy_iterator():
...   print(elem)
[[ 0 -1 -1]
 [ 5  6  7]]
[[ 1  2  3  4 -1 -1]
