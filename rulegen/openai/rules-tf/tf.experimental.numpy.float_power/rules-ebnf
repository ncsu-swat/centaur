>>
Rule 4 (dimension check for broadcasting)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∨ ndim(v_1) = 1 ∨ ndim(v_2) = 1
>>
Rule 6 (both tensors must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 11 (x1 and x2 shapes are broadcastable)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∨ (ndim(v_1) = 1 ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, 0) = 1) ∨ (ndim(v_2) = 1 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, 0) = 1)
>>
Rule 13 (x1 and x2 should have compatible shapes for element-wise operations)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = ndim(v_2) ∨ (ndim(v_1) = 1 ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, 0) = 1) ∨ (ndim(v_2) = 1 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, 0) = 1))
>>
Rule 15 (both tensors should have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 22 (both tensors must have the same shape)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 25 (both tensors must have compatible dtypes, either both are floating-point types)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 26 (Both tensors must be non-empty)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0)
