Rule 1 (Check if tensor x1 and x2 have compatible shapes for matmul)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then true else if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then true else false
>>
Rule 3 (Check if tensors x1 and x2 have at least one dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 5 (Check if the number of dimensions of tensors x1 and x2 are greater than or equal to 1)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 9 (Check if the number of dimensions of x1 and x2 are greater than 0 and less than 5)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ndim(v_1) < 5 ∧ ndim(v_2) < 5
>>
Rule 10 (Check if the product of the shape dimensions is greater than 0)
{v_1 : tensor, v_2 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ ∃j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0
>>
Rule 11 (Check if one of the tensors is a scalar)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 0 ∨ ndim(v_2) = 0
>>
Rule 13 (Check if tensors are not empty)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 15 (Check if tensors have compatible shapes for broadcasting)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)) ∨ (ndim(v_1) = 1 ∧ ndim(v_2) > 1 ∧ shape(v_1, 0) = shape(v_2, ndim(v_2) - 1)) ∨ (ndim(v_1) > 1 ∧ ndim(v_2) = 1 ∧ shape(v_2, 0) = shape(v_1, ndim(v_1) - 1))
>>
Rule 18 (Check if the first dimension of both tensors is compatible for broadcasting)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 1 ∨ shape(v_1, 0) = 1) ∧ (ndim(v_2) = 1 ∨ shape(v_2, 0) = 1)
