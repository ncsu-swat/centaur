Rule 1 (tensor dtype should be float or int)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5
>>
Rule 2 (tensor dtype must be matching)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (v_1 and v_2 tensor shape must be the same)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 4 (the dimension of tensor v_1 and v_2 should be greater than 0)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 5 (shape of tensor v_1 should be greater than 0)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 6 (the number of tuple v_1 should be greater than 0)
{v_1 : tuple(int)} |= v_1.len > 0
>>
Rule 7 (v_1 should be greater than 0)
{v_1 : int ⊎ float} |= v_1 > 0
>>
Rule 8 (v_1 and v_2 should be greater than 0)
{v_1 : int ⊎ float, v_2 : int ⊎ float} |= v_1 > 0 ∧ v_2 > 0
>>
Rule 9 (v_1 or v_2 should be greater than 0)
{v_1 : int ⊎ float, v_2 : int ⊎ float} |= v_1 > 0 ∨ v_2 > 0
>>
Rule 10 (tensor x1 and x2 can not be both empty)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∨ ndim(v_2) > 0
>>
Rule 12 (tensor x1 and x2 should be scalar or have compatible shapes for broadcasting)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 0 ∨ ndim(v_2) = 0 ∨ ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 13 (if one of the tensors is scalar, the other one must be compatible)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 0 ∧ true) ∨ (ndim(v_2) = 0 ∧ true)
>>
Rule 15 (x1 and x2 are floating point tensors)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = 8 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 9 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 9
>>
Rule 16 (x1 and x2 are tensors with the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 22 (x1 and x2 are integers or floats representing numerical values.)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) ∧ (dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5)
>>
Rule 23 (x1 and x2 have at least one dimension or are scalars)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) > 0) ∨ (ndim(v_2) > 0) ∨ (ndim(v_1) = 0) ∨ (ndim(v_2) = 0)
>>
Rule 24 (x1 and x2 cannot be complex tensors)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 10 ∧ dtype_(v_1) ≠ 11 ∧ dtype_(v_2) ≠ 10 ∧ dtype_(v_2) ≠ 11
>>
Rule 25 (If x1 is 0, x2 should also be 0 to avoid division by zero)
{v_1 : tensor, v_2 : tensor} |= (v_1 = 0) ∨ (v_2 = 0) ∨ true
>>
Rule 28 (If x1 and x2 are both float tensors, their dtypes must be the same)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 7 ∧ dtype_(v_2) = 7) ∨ (dtype_(v_1) = 8 ∧ dtype_(v_2) = 8)
>>
Rule 29 (If x1 and x2 are both int tensors, their dtypes must be the same)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 1 ∧ dtype_(v_2) = 1) ∨ (dtype_(v_1) = 2 ∧ dtype_(v_2) = 2) ∨ (dtype_(v_1) = 3 ∧ dtype_(v_2) = 3) ∨ (dtype_(v_1) = 4 ∧ dtype_(v_2) = 4) ∨ (dtype_(v_1) = 5 ∧ dtype_(v_2) = 5)
>>
Rule 30 (If either x1 or x2 is a complex tensor, the other one must also be complex)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 9 ∧ (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)) ∨ (dtype_(v_2) = 9 ∧ (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10))
