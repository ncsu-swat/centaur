Rule 4 (check tensor size)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 5 (check shape compatibility)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∨ (ndim(v_1) > 1 ∧ ndim(v_2) > 1 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 7 (check if x or y is zero)
{v_1 : tensor, v_2 : tensor} |= v_1 ≠ 0 ∧ v_2 ≠ 0
>>
Rule 8 (check if either shape is empty)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) > 0 ∧ shape(v_2, 0) > 0
>>
Rule 10 (shape should equal)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 11 (check if x and y have equal dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 13 (minimum shape dimension)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) >= 1 ∧ shape(v_2, 0) >= 1
