>>
Rule 1 (input tensors must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (non-negative integer number)
{v_1 : int } |= v_1 ≥ 0
>>
Rule 3 (input tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 6 (the number of tensor dimensions must be positive)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 7 (the second number of tensor dimensions must be positive)
{v_2 : tensor} |= ndim(v_2) > 0
>>
Rule 8 (the two tensors have some dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 9 (broadcasting compatibility for tensor shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1 ∨ shape(v_2, i) = 1 ∨ shape(v_1, i) = shape(v_2, i)
>>
Rule 10 (a primitive type variable is smaller than the other)
{v_1 : int , v_2 : int } |= v_1 ≤ v_2
>>
Rule 12 (first dimension of a tensor matches second dimension of the other)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, 0) = shape(v_2, 1)
>>
Rule 13 (the first argument is zero)
{v_1 : int } |= v_1 = 0
