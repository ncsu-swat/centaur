>>
Rule 1 (combiner must be one of 'mean', 'sqrtn' or 'sum')
{combiner : str} |= combiner = "mean" ∨ combiner = "sqrtn" ∨ combiner = "sum"
>>
Rule 3 (sparse_ids should have rank 2)
{sp_ids : tensor} |= ndim(sp_ids) = 2
>>
Rule 4 (sparse_weights, if present, should have the same shape as sp_ids)
{sp_ids : tensor, sp_weights : tensor} |= sp_weights = None ∨ (ndim(sp_ids) = ndim(sp_weights) ∧ ∀i ∈ [0, ndim(sp_ids) - 1] : shape(sp_ids, i) = shape(sp_weights, i))
>>
Rule 5 (max_norm should be non-negative if it exists)
{max_norm : float} |= max_norm = None ∨ max_norm ≥ 0
>>
Rule 13 (sp_ids should have at least two dimensions)
{sp_ids : tensor} |= ndim(sp_ids) ≥ 2
