<if_expr> ::= "if" <expr> "then" <expr> [ "else" <expr> ]
<compare_expr> ::= <arith_expr> | <arith_expr> <COMPOP> <arith_expr>
<arith_expr> ::= <arith_expr> <ADDOP> <arith_term> | <arith_term>
<arith_term> ::= <arith_term> <MULOP> <arith_factor> | <arith_factor>
