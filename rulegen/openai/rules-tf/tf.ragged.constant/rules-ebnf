{v_1 : tensor, v_2 : list(str)} |= v_2.len = ndim(v_1) ∧ ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [i + 1, v_2.len - 1] : v_2[i] ≠ v_2[j]
>>
Rule 20 (valid input dimension for embedding layer)
{v_1 : int, v_2 : int} |= v_1 > 0 ∧ v_2 > 0
