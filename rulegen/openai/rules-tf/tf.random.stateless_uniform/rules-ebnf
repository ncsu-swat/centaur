Rule 1 (seed must be a 2-D tensor)
{seed : tensor} |= ndim(seed) = 2
>>
Rule 4 (if dtype is integral, either both minval and maxval must be None or neither may be None)
{minval : tensor, maxval : tensor, dtype : dtype} |= ((minval = None ∧ maxval = None) ∨ (minval ≠ None ∧ maxval ≠ None)) ∧ (dtype = 4 ∨ dtype = 5)
>>
Rule 5 (shape must be a 1-D tensor)
{shape : tensor} |= ndim(shape) = 1
>>
Rule 6 (minval and maxval must be scalars if not None)
{minval : tensor, maxval : tensor} |= (minval = None ∨ ndim(minval) = 0) ∧ (maxval = None ∨ ndim(maxval) = 0)
>>
Rule 7 (dtype must be one of the allowed types)
{dtype : dtype} |= dtype = 4 ∨ dtype = 5 ∨ dtype = 6 ∨ dtype = 7 ∨ dtype = 8
>>
Rule 8 (shape elements must be non-negative integers)
{shape : tensor} |= ∀i ∈ [0, shape.len - 1] : shape[i] ≥ 0 ∧ shape[i] = integer
>>
Rule 9 (minval and maxval must be finite)
{minval : tensor, maxval : tensor} |= minval ≠ infinity ∧ maxval ≠ infinity
>>
Rule 10 (if dtype is integral, minval must be less than maxval)
{minval : tensor, maxval : tensor, dtype : dtype} |= (dtype = 4 ∨ dtype = 5) ∧ (minval = None ∨ maxval = None ∨ minval < maxval)
>>
Rule 21 (the len of seed must be 2)
{seed : tensor} |= shape(seed, 0) = 2
>>
Rule 30 (valid range for minval and maxval)
{minval : tensor, maxval : tensor, dtype : dtype} |= if dtype = 4 ∨ dtype = 5 then minval ≤ maxval
>>
Rule 31 (dtype should be type 4 or 5 when the range is unbounded)
{minval : tensor, maxval : tensor, dtype : dtype} |= (minval = None ∧ maxval = None) ∨ (dtype = 4 ∨ dtype = 5)
>>
Rule 33 (zero seed)
{seed : tensor} |= seed ≠ 0
>>
Rule 35 (valid shape for seed tensor)
{seed : tensor} |= shape(seed, 0) = 1 ∧ shape(seed, 1) = 2
