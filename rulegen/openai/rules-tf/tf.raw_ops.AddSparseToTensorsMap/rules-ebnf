>>
Rule 5 (sparse_indices should be a 2-D tensor)
{sparse_indices : tensor} |= ndim(sparse_indices) = 2
>>
Rule 6 (sparse_values should be a 1-D tensor)
{sparse_values : tensor} |= ndim(sparse_values) = 1
>>
Rule 7 (sparse_shape should be a 1-D tensor)
{sparse_shape : tensor} |= ndim(sparse_shape) = 1
>>
Rule 8 (tuple of ints represents shape)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 9 (shape dimensions should be positive integers)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1, i) - 1] : shape(v_1, i) > 0
>>
Rule 18 (sparse_shape elements should be positive integers)
{sparse_shape : tensor} |= ∀i ∈ [0, shape(sparse_shape, 0) - 1] : sparse_shape[i] > 0
>>
Rule 21 (sparse_indices and sparse_shape should have the same number of dimensions)
{sparse_indices : tensor, sparse_shape : tensor} |= ndim(sparse_indices) = ndim(sparse_shape)
>>
Rule 25 (sparse_indices shape should be non-empty)
{sparse_indices : tensor} |= shape(sparse_indices, 0) > 0 ∧ shape(sparse_indices, 1) > 0
>>
Rule 26 (sparse_shape shape should be non-empty)
{sparse_shape : tensor} |= shape(sparse_shape, 0) > 0
>>
Rule 27 (sparse_values should have at least one dimension)
{sparse_values : tensor} |= ndim(sparse_values) ≥ 1
>>
Rule 34 (container and shared_name cannot both be empty strings)
{container : str, shared_name : str} |= container ≠ "" ∨ shared_name ≠ ""
