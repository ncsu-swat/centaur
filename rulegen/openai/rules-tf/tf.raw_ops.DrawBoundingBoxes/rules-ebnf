>>
Rule 1 (images and boxes should have the same batch size)
{images : tensor, boxes : tensor} |= shape(images, 0) = shape(boxes, 0)
>>
Rule 2 (images depth dimension should be positive)
{images : tensor} |= shape(images, 3) > 0
>>
Rule 3 (boxes dimension should be positive)
{boxes : tensor} |= ndim(boxes) > 0
>>
Rule 4 (boxes dimension 0 should be positive)
{boxes : tensor} |= shape(boxes, 0) > 0
>>
Rule 5 (boxes dimension 1 should be positive)
{boxes : tensor} |= shape(boxes, 1) > 0
>>
Rule 6 (boxes dimension 2 should be positive)
{boxes : tensor} |= shape(boxes, 2) > 0
>>
Rule 7 (boxes dimension 3 should be 4)
{boxes : tensor} |= shape(boxes, 2) = 4
>>
Rule 10 (images tensor must be 4D)
{images : tensor} |= ndim(images) = 4
>>
Rule 11 (boxes tensor must be 3D)
{boxes : tensor} |= ndim(boxes) = 3
>>
Rule 12 (boxes tensor's last dimension should be 4)
{boxes : tensor} |= shape(boxes, ndim(boxes) - 1) = 4
>>
Rule 13 (images tensor's last dimension must be greater than zero)
{images : tensor} |= shape(images, ndim(images) - 1) > 0
>>
Rule 19 (name is a non-empty string)
{name : str} |= if name = "" then false
