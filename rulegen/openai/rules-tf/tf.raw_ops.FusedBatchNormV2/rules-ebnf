>>
Rule 1 (data_format must be one of the specified strings)
{v_1 : str} |= v_1 = "NHWC" ∨ v_1 = "NCHW"
>>
Rule 2 (all tensors should not be zero)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= v_1 ≠ 0 ∧ v_2 ≠ 0 ∧ v_3 ≠ 0
>>
Rule 3 (x, scale, offset, mean, variance should have the same number of dimensions)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor, v_5 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ndim(v_1) = ndim(v_3) ∧ ndim(v_1) = ndim(v_4) ∧ ndim(v_1) = ndim(v_5)
>>
Rule 4 (x, scale, offset, mean, variance should be valid tensors(ndim > 0))
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor, v_5 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ndim(v_3) > 0 ∧ ndim(v_4) > 0 ∧ ndim(v_5) > 0
>>
Rule 5 (epsilon and exponential_avg_factor must be greater than 0)
{v_1 : float, v_2 : float} |= v_1 > 0 ∧ v_2 > 0
>>
Rule 6 (is_training should be a boolean value)
{v_1 : bool} |= v_1 = True ∨ v_1 = False
>>
Rule 8 (x, scale, offset, mean, variance must have float32 dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor, v_5 : tensor} |= dtype_(v_1) = 3 ∧ dtype_(v_2) = 3 ∧ dtype_(v_3) = 3 ∧ dtype_(v_4) = 3 ∧ dtype_(v_5) = 3
>>
Rule 11 (x must be a 4D tensor)
{v_1 : tensor} |= ndim(v_1) = 4
>>
Rule 12 (scale, offset, mean, variance must be 1D tensors)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ ndim(v_3) = 1 ∧ ndim(v_4) = 1
>>
Rule 13 (shape compatibility between x and scale, offset, mean, variance)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= shape(v_1, 3) = shape(v_2, 0) ∧ shape(v_1, 3) = shape(v_3, 0) ∧ shape(v_1, 3) = shape(v_4, 0)
>>
Rule 14 (check mean and variance values for training)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= (v_3 = True ∧ (shape(v_1, 0) = 0 ∧ shape(v_2, 0) = 0)) ∨ (v_3 = False ∧ shape(v_1, 0) > 0 ∧ shape(v_2, 0) > 0)
>>
Rule 16 (x must be of half, bfloat16, or float32 dtype)
{v_1 : tensor} |= dtype_(v_1) = 16 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 7
>>
Rule 17 (scale, offset, mean, and variance must have float32 dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= dtype_(v_1) = 7 ∧ dtype_(v_2) = 7 ∧ dtype_(v_3) = 7 ∧ dtype_(v_4) = 7
>>
Rule 18 (epsilon must be greater than zero)
{v_1 : float} |= v_1 > 0
>>
Rule 32 (When training, mean and variance must be empty tensors; otherwise, they must not be empty)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= (v_3 = True ∧ (shape(v_1, 0) = 0 ∧ shape(v_2, 0) = 0)) ∨ (v_3 = False ∧ (shape(v_1, 0) > 0 ∧ shape(v_2, 0) > 0))
>>
Rule 33 (x must be of half, bfloat16, or float32 dtype)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 1 ∨ dtype_(v_1) = 2
>>
Rule 35 (The scale tensor must have values greater than zero)
{v_1 : tensor} |= min(v_1) > 0
>>
Rule 36 (The shape of x along the last axis must be greater than zero)
{v_1 : tensor} |= shape(v_1, 3) > 0
>>
Rule 37 (The input x tensor's dtype must be a valid integer.)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 7
