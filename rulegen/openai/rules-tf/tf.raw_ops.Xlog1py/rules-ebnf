>>
Rule 5 (x and y are not none)
{x : tensor, y : tensor} |= x ≠ none ∧ y ≠ none
>>
Rule 6 (Checking for zero values in x)
{x : tensor} |= ∀i ∈ [0, shape(x, 0) - 1] : x[i] ≠ 0
>>
Rule 7 (Checking positive shape dimensions)
{x : tensor} |= ndim(x) > 0 ∧ ∀i ∈ [0, ndim(x) - 1] : shape(x, i) > 0
>>
Rule 8 (x and y shapes are compatible for elementwise operation)
{x : tensor, y : tensor} |= shape(x) = shape(y)
>>
Rule 9 (tensor x has at least one dimension)
{x : tensor} |= ndim(x) > 0
>>
Rule 18 (x and y are broadcasting compatible)
{x : tensor, y : tensor} |= ndim(x) > 0 ∧ ndim(y) > 0 ∧ (shape(x) = shape(y) ∨ (ndim(x) < ndim(y) ∧ ∀i ∈ [0, ndim(x)-1] : shape(x, i) = 1) ∨ (ndim(y) < ndim(x) ∧ ∀i ∈ [0, ndim(y)-1] : shape(y, i) = 1))
>>
Rule 27 (x has a positive number of dimensions)
{x : tensor} |= (ndim(x) > 0)
>>
Rule 28 (shape dimensions are positive)
{x : tensor} |= (ndim(x) > 0 ∧ ∀i ∈ [0, ndim(x) - 1] : (shape(x, i) > 0))
>>
Rule 29 (x and y have compatible shapes for elementwise operations)
{x : tensor, y : tensor} |= (shape(x) = shape(y))
>>
Rule 31 (x's first dimension is greater than 1)
{x : tensor} |= (ndim(x) > 0 ∧ shape(x, 0) > 1)
>>
Rule 32 (tensor x has a minimum of two dimensions)
{x : tensor} |= (ndim(x) >= 2)
>>
Rule 33 (ndim(x) equals the length of a tuple)
{x : tensor, v_1 : tuple(int)} |= (ndim(x) = v_1.len)
>>
Rule 42 (Valid dimension index)
{v_1 : tensor, v_2 : int} |= (0 ≤ v_2 ∧ v_2 < ndim(v_1))
>>
Rule 43 (Tuple of ints represents valid shape dimensions)
{v_1 : tuple(int)} |= (∀i ∈ [0, v_1.len - 1] : v_1[i] > 0)
>>
Rule 44 (List of ints used as dimensions/axes, all non-negative)
{v_1 : list(int)} |= (∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0)
>>
Rule 45 (Length of list of ints must be equal to ndim(x))
{x : tensor, v_1 : list(int)} |= (v_1.len = ndim(x))
