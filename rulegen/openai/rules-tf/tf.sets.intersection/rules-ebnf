>>
Rule 4 (a and b should have at least one dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 5 (the last dimension of a and b must have compatible sizes)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, -1) ≥ 0 ∧ shape(v_2, -1) ≥ 0
>>
Rule 6 (the product of the shape of a and b should not overflow)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, -1) × shape(v_2, -1) ≤ 1000000000
>>
Rule 7 (the first dimension of a and b should be greater than or equal to one)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) ≥ 1 ∧ shape(v_2, 0) ≥ 1
>>
Rule 10 (a and b should have a compatible number of dimensions)
{v_1 : tensor, v_2 : tensor} |= -1 × ndim(v_1) ≤ ndim(v_2) ∧ ndim(v_2) ≤ ndim(v_1)
>>
Rule 13 (a and b should have valid indices)
{v_1 : tensor, v_2 : tensor} |= (∃ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ (∃ i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 0)
>>
Rule 14 (all dimensions accept empty sizes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_2) ≥ 0
>>
Rule 15 (shapes should be greater than zero)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∃ i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0)
>>
Rule 17 (shape of a and b must match along all axes but the last)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 2] : shape(v_1, i) = shape(v_2, i))
>>
Rule 24 (ndim > 0)
{a: tensor, b: tensor} |= ndim(a) > 0 ∧ ndim(b) > 0
>>
Rule 27 (common dimensions size)
{a : tensor, b : tensor} |= ∀i ∈ [0, ndim(a)-1] : shape(a, i) = shape(b, i)
>>
Rule 29 (shape dimension is positive)
{a : tensor} |= ∀i ∈ [0, ndim(a)-1] : shape(a, i) > 0
>>
Rule 42 (validate_indices is true, a and b have the same shape)
{a: tensor, b: tensor, validate_indices: bool} |= validate_indices = True ∧ shape(a) = shape(b)
>>
Rule 44 (shape of a and b must have at least one dimension)
{a: tensor, b: tensor} |= ndim(a) ≥ 1 ∧ ndim(b) ≥ 1
>>
Rule 45 (validate_indices must be either true or false and dimensions of tensors must be greater than zero)
{a: tensor, b: tensor, validate_indices: bool} |= (validate_indices = True ∨ validate_indices = False) ∧ (ndim(a) > 0 ∧ ndim(b) > 0)
>>
Rule 46 (ndim(a) and ndim(b)  must be equal, and shape must be equal)
{a: tensor, b:tensor} |= ndim(a) = ndim(b) ∧ shape(a) = shape(b)
