  >>> b = tf.constant([1,2], tf.int32)
  >>> tf.tile(a, b)
  <tf.Tensor: shape=(2, 6), dtype=int32, numpy=
  array([[1, 2, 3, 1, 2, 3],
         [4, 5, 6, 4, 5, 6]], dtype=int32)>
  >>> c = tf.constant([2,1], tf.int32)
  >>> tf.tile(a, c)
