         | "bool"
         | "dtype"
         | "str"
         | "list" "(" <type> ")"
         | "tuple" "(" <type> ")"
         | <type> "⊎" <type>

<expr> ::= <and_expr>
<and_expr> ::= <or_expr> | <and_expr> "∧" <or_expr>
