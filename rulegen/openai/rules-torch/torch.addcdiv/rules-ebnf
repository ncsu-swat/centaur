Rule 1 (tensor shapes should be the same)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ndim(v_2) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = shape(v_3, i)
>>
Rule 2 (tensor shapes must be broadcastable)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) ≤ ndim(v_2) ∧ ndim(v_3) ≤ ndim(v_2) ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = shape(v_1, i) ∨ shape(v_2, i) = 1 ∨ shape(v_3, i) = 1
>>
Rule 21 (primitive type variable should not be zero)
{v_1 : int ⊎ float} |= v_1 ≠ 0
>>
Rule 22 (valid step size for a range)
{v_1 : int ⊎ float, v_2 : int ⊎ float, v_3 : int ⊎ float} |= if v_1 > 0 then v_2 ≤ v_3 else if v_1 < 0 then v_2 ≥ v_3
>>
Rule 23 (3-dimensional tensor with all positive shape dimensions)
{v_1 : tensor} |= ndim(v_1) = 3 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 24 (tuple of ints represents valid shape dimensions)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 25 (Integer indices only valid with int-compatible dtype)
{v_1 : tuple(int), v_2 : dtype} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0 ∧ v_2 = 1 ∨ v_2 = 2 ∨ v_2 = 3 ∨ v_2 = 4 ∨ v_2 = 5
