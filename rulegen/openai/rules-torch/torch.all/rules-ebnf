>>
Rule 7 (dim must be within the range of input tensor dimensions)
{v_1 : tensor, v_2 : int} |= v_2 < ndim(v_1)
>>
Rule 10 (If dim is a tuple, each element must be a valid dimension)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0 ∧ v_2[i] < ndim(v_1)
>>
Rule 13 (Input tensor cannot be empty)
{v_1 : tensor} |= shape(v_1, 0) > 0
