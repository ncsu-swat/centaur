Rule 53 (If dim is a tuple, each element must be a valid dimension)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : v_2[i] >= 0 ∧ v_2[i] < ndim(v_1)
>>
Rule 60 (Dimension out of range - out of bounds check)
{v_1 : tensor, v_2 : int} |= v_2 >= 0 ∧ v_2 < ndim(v_1)
>>
Rule 64 (Input tensor must have a positive shape dimension)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 65 (out tensor is the same shape as input if dim is not specified)
{v_1 : tensor, v_4 : tensor} |= ndim(v_1) = ndim(v_4) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_4, i)
