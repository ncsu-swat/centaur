Rule 2 (input tensor dtype matches output tensor dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (tuple of ints must be non-empty)
{v_1 : tuple(int)} |= v_1.len > 0 ∧ ∀i ∈ [0, v_1.len - 1] : v_1[i] ≠ 0
>>
Rule 5 (tensor dimensions must not appear multiple times)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) ≥ 1 ∧ v_2.len > 0 ∧ ∀i ∈ [0, v_2.len - 1] : v_2[i] ≠ v_2[0]
>>
Rule 6 (tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1 ∧ shape(v_1, 0) ≠ 0
>>
Rule 7 (input tensor should be compatible with output tensor)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ shape(v_1, 0) ≠ 0 ∧ dtype_(v_1) = dtype_(v_2)
