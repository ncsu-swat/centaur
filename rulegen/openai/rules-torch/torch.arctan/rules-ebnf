Rule 1 (tensor shape matches given tuple shape)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) = v_2.len ∧ ∀i ∈ [0, v_2.len - 1] : shape(v_1, i) = v_2[i]
>>
Rule 2 (input tensor is empty or only contains non-negative values)
{v_1 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ min(v_1) ≥ 0
>>
Rule 4 (list of floats for weights must match length of a tensor dimension)
{v_1 : tensor, v_2 : list(float)} |= v_2.len = shape(v_1, 0) ∧ ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0
>>
Rule 9 (input tensor matches output tensor shape)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 12 (tensor contains no negative values)
{v_1 : tensor} |= min(v_1) ≥ 0
