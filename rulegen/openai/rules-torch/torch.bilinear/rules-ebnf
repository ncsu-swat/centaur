Rule 3 (bias size must match weight size)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
>>
Rule 4 (input tensors must have matching input features)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, -1) = shape(v_2, -1)
>>
Rule 5 (weight tensor must have valid dimensions)
{v_1 : tensor} |= ndim(v_1) = 3
>>
Rule 6 (bias tensor must be a vector)
{v_1 : tensor} |= ndim(v_1) = 1
>>
Rule 8 (output tensor must be valid)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_2) ∧ shape(v_1, -1) = shape(v_3, 0)
