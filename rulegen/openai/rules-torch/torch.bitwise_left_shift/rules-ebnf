Rule 1 (input and other tensors should have compatible sizes for broadcasting)
{v_1 : tensor, v_2 : tensor} |= (shape(v_1) = shape(v_2)) ∨ (ndim(v_1) = ndim(v_2))
>>
Rule 6 (check output tensor shape)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= shape(v_1) = shape(v_3) ∨ shape(v_2) = shape(v_3)
>>
Rule 7 (valid input shape)
{v_1 : tensor} |= ndim(v_1) >= 1
>>
Rule 8 (valid input tensor dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 15 (input tensor should not be empty)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 16 (other tensor should not be empty)
{v_2 : tensor} |= ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 19 (other tensor has positive shape dimensions)
{v_2 : tensor} |= ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 21 (if input is a scalar, the other must be a scalar as well)
{v_1: tensor, v_2: tensor} |= (ndim(v_1) = 0 ∧ ndim(v_2) = 0) ∨ (ndim(v_1) > 0 ∧ ndim(v_2) > 0)
>>
Rule 22 (input and other tensor have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
