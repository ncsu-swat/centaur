>>
Rule 1 (tensor list must not be empty)
{v_1 : list(tensor)} |= v_1.len > 0
>>
Rule 2 (tensor dimensions should match except in dimension 0)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0) ∧ ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [1, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 6 (dimension parameter must be valid for tensor concatenation)
{v_1 : tensor, v_2 : int} |= 0 ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 10 (tensor list should not contain null tensors)
{v_1 : list(tensor)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≠ null
