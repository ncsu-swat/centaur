>>
Rule 1 (input tensor must be valid)
{v_1 : tensor} |= v_1 ≠ 0
>>
Rule 2 (dimension index should be within valid range)
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 ∧ v_2 < ndim(v_1)
>>
Rule 3 (tensor dimensions should match the specified dim)
{v_1 : tensor, v_2 : int} |= ndim(v_1) = ndim(v_2)
>>
Rule 5 (dim parameter should be valid integer or tuple of integers)
{v_1 : tensor, v_2 : int ⊎ tuple(int)} |= v_2 ≠ 0 ∧ ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0 ∧ v_2[i] < ndim(v_1)
