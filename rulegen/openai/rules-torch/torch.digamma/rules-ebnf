>>
Rule 1 (tensor input must be of type float or complex)
{v_1 : tensor} |= v_1 = "float" ∨ v_1 = "complex"
>>
Rule 4 (input tensor should not be empty)
{v_1 : tensor} |= shape(v_1, 0) > 0
>>
Rule 5 (output tensor should match input tensor shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
