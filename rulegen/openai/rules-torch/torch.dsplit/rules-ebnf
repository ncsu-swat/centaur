Rule 1 (tensor shapes should be the same)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 2 (valid step size for a range)
{v_1 : int ⊎ float, v_2 : int ⊎ float, v_3 : int ⊎ float} |= if v_1 > 0 then v_2 ≤ v_3 else if v_1 < 0 then v_2 ≥ v_3
>>
Rule 3 (reduction over valid dimensions)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 4 (last dimension of a tensor matches first dimension of the other)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, 0)
>>
Rule 7 (tensor with at least 3 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 3
>>
Rule 8 (positive number of sections)
{v_1 : int} |= v_1 > 0
>>
Rule 9 (divisible dimension size)
{v_1 : tensor, v_2 : int} |= shape(v_1, 2) % v_2 = 0
>>
Rule 10 (integer representation in IntArrayRef)
{v_1 : int} |= v_1 ≠ 0
>>
Rule 11 (tensor split along dimension 2)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 3 ∧ shape(v_1, 2) = v_2
>>
Rule 21 (primitive type variable should not be zero)
{v_1 : int ⊎ float} |= v_1 ≠ 0
