>>
Rule 1 (tensor must have same shape)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 3 (tensor elements must be equal)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i] = v_2[i]
>>
Rule 4 (tensor must not contain NaNs)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i] ≠ NaN
>>
Rule 9 (tensor must not contain NaNs)
{v_1 : tensor} |= (v_1 ≠ NaN)
