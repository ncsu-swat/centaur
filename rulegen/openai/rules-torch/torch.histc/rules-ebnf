Rule 1 (tensor shapes should be the same)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (histogram bins must be positive)
{v_1 : int} |= v_1 > 0
>>
Rule 4 (histogram min must be less than or equal to max)
{v_1 : float, v_2 : float} |= v_1 ≤ v_2
>>
Rule 7 (tensor input should have a valid shape for histogram)
{v_1 : tensor, v_2 : int} |= ndim(v_1) = 1 ∧ ∀i ∈ [0, v_1.len - 1] : shape(v_1, i) = v_2
>>
Rule 9 (histogram input tensor should not contain NaN values)
{v_1 : tensor} |= v_1 ≠ NaN
>>
Rule 10 (tensor input should have valid range for histogram)
{v_1 : tensor, v_2 : float, v_3 : float} |= min(v_1) ≥ v_2 ∧ max(v_1) ≤ v_3
>>
Rule 14 (histogram input tensor should not have negative values)
{v_1 : tensor} |= min(v_1) ≥ 0
>>
Rule 16 (histogram input tensor should have same size as bins)
{v_1 : tensor, v_2 : int} |= ndim(v_1) = 1 ∧ shape(v_1, 0) = v_2
