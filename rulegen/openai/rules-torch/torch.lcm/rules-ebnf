Rule 3 (input and output tensors have the same shape)
{v_1 : tensor, v_3 : tensor} |= shape(v_1) = shape(v_3)
>>
Rule 8 (input tensor is not empty)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 9 (other tensor is not empty)
{v_2 : tensor} |= ndim(v_2) > 0
>>
Rule 10 (input shape contains at least one non-zero element)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 31 (both inputs must have at least one dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 33 (output tensor's size must match the size of one of the inputs at non-singleton dimension 0)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ndim(v_3) > 0 ∧ (shape(v_1, 0) = shape(v_3, 0) ∨ shape(v_2, 0) = shape(v_3, 0))
>>
Rule 34 (at least one input must be defined)
{v_1 : tensor, v_2 : tensor} |= v_1 ≠ None ∨ v_2 ≠ None
