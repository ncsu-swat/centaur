Rule 1 (tensor must have compatible shapes for broadcasting)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) ≠ shape(v_2) ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 2 (tensor should not be empty)
{v_1 : tensor} |= ndim(v_1) > 0 ∧ shape(v_1, 0) > 0
>>
Rule 4 (tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 5 (tensor should have valid shape dimensions)
{v_1 : tensor} |= shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 6 (tensor must match size of other tensor at non-singleton dimension)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 1) = shape(v_2, 1)
>>
Rule 9 (tensor must have compatible size with another tensor)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
>>
Rule 12 (tensor must have compatible size with result)
{v_1 : tensor} |= shape(v_1, 0) = shape(v_1, 0)
>>
Rule 15 (tensor must have compatible dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
