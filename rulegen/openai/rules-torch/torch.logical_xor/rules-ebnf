>>
Rule 1 (input tensors must have the same shape)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 3 (input tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 4 (input tensors must have matching size at non-singleton dimension 0)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
>>
Rule 9 (input tensors must not have zero-sized dimensions)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) ≠ 0 ∧ shape(v_2, 0) ≠ 0
>>
Rule 10 (input tensors must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2) ∨ shape(v_1) ≠ shape(v_2)
>>
Rule 12 (tensor parameters must have valid shape)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) ≠ null ∧ shape(v_2) ≠ null
>>
Rule 17 (output tensor must match input tensor dimensions)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_3) = ndim(v_1) ∧ ndim(v_3) = ndim(v_2)
