Rule 1 (primitive type variable should not be zero)
{v_1 : int ⊎ float} |= v_1 ≠ 0
>>
Rule 2 (input tensor has valid dimensionality)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 3 (tensor dimensions are within bounds)
{v_1 : tensor, v_2 : int} |= 0 ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 4 (start index is valid for the specified dimension)
{v_1 : tensor, v_2 : int, v_3 : int} |= 0 ≤ v_3 ∧ v_3 < shape(v_1, v_2)
>>
Rule 6 (start plus length does not exceed dimension size)
{v_1 : tensor, v_2 : int, v_3 : int, v_4 : int} |= v_3 + v_4 ≤ shape(v_1, v_2)
>>
Rule 9 (tensor shape is non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1)-1] : shape(v_1, i) ≥ 0
>>
Rule 11 (output tensor matches input tensor in shape)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 12 (tensor has valid shape dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1)-1] : shape(v_1, i) > 0
>>
Rule 13 (input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 14 (tensor is not empty)
{v_1 : tensor} |= shape(v_1, 0) > 0
>>
Rule 18 (length must be positive and not exceed dimension size)
{v_1 : tensor, v_2 : int, v_3 : int} |= 0 < v_3 ∧ v_3 ≤ shape(v_1, v_2)
