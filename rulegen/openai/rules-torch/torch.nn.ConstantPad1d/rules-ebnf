Rule 8 (input size plus negative padding results in a negative output size)
{v_1 : int, v_2 : tensor} |= v_1 ≥ 0 ∧ v_1 ≤ ndim(v_2)
>>
Rule 11 (input tensor is empty or only contains non-negative values)
{v_1 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ min(v_1) ≥ 0
>>
Rule 12 (input tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 13 (broadcasting compatibility for tensor shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 18 (primitive type variable should not be zero)
{v_1 : int ⊎ float} |= v_1 ≠ 0
