Rule 2 (start_dim and end_dim must be within valid range for input tensor dimensions)
{v_1 : int, v_2 : int, v_3 : tensor} |= (0 ≤ v_1 ∧ v_1 ≤ ndim(v_3) - 1) ∧ (0 ≤ v_2 ∧ v_2 ≤ ndim(v_3) - 1) ∧ v_1 ≤ v_2
>>
Rule 3 (input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 4 (input tensor should not be empty)
{v_1 : tensor} |= shape(v_1, 0) > 0
>>
Rule 7 (input tensor should have valid size along flattened dimensions)
{v_1 : tensor, v_2 : int, v_3 : int} |= (shape(v_1, v_2) > 0 ∧ shape(v_1, v_3) > 0) ∧ v_2 ≤ v_3
>>
Rule 9 (tensor dimensions must align properly for flatten operation)
{v_1 : tensor, v_2 : int, v_3 : int} |= (ndim(v_1) ≥ 1 ∧ shape(v_1, 0) > 0 ∧ v_2 ≠ v_3) ∧ v_2 ≤ v_3
