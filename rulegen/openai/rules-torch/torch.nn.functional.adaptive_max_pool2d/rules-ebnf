Rule 4 (input tensor must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 5 (tensor must not be empty)
{v_1 : tensor} |= v_1.len > 0
>>
Rule 12 (tensor must have valid dimensions)
{v_1 : tensor, v_2 : tuple(int)} |= v_1.len > 0 ∧ v_2.len = 2
