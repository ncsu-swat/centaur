Rule 1 (input tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 2 (input tensors must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2) ∧ ∀i ∈ [0, ndim(v_1)-1] : shape(v_1,i) = shape(v_2,i)
>>
Rule 8 (input tensors must have same shape in specified dimension)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, dim) = shape(v_2, dim)
>>
Rule 10 (input tensors must have same number of elements)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
>>
Rule 12 (input tensors must have compatible shapes for broadcast)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) ≠ shape(v_2) ∧ ∀i ∈ [0, ndim(v_1)-1] : shape(v_1,i) = shape(v_2,i)
>>
