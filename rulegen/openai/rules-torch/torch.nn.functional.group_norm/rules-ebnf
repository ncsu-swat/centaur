Rule 1 (tensor shapes should be the same)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 2 (input tensor must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 3 (num_groups must be greater than 0)
{v_1 : int} |= v_1 > 0
>>
Rule 4 (number of channels in input must be divisible by num_groups)
{v_1 : tensor, v_2 : int} |= shape(v_1, 1) % v_2 = 0
>>
Rule 5 (weight tensor must have size equal to number of channels in input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = 1 ∧ shape(v_2, 0) = shape(v_1, 1)
>>
Rule 7 (epsilon must be positive)
{v_1 : float} |= v_1 > 0
>>
Rule 8 (input tensor must not be empty)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0
>>
Rule 9 (tensor should contain only non-negative values)
{v_1 : tensor} |= min(v_1) ≥ 0
>>
Rule 13 (input tensor must not contain zero dimensions)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≠ 0
>>
Rule 14 (input tensor must have at least one dimension with size > 0)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 15 (input tensor must be valid for group normalization)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 2 ∧ shape(v_1, 1) ≠ 0 ∧ shape(v_1, 1) % v_2 = 0
>>
Rule 17 (weight and bias tensors must match input dimensions)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_2) = 1 ∧ shape(v_2, 0) = shape(v_1, 1) ∧ ndim(v_3) = 1 ∧ shape(v_3, 0) = shape(v_1, 1)
