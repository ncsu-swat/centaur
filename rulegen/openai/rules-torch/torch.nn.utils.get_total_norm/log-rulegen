    {v_1 : int ⊎ float} |= v_1 ≠ 0

[Example Rules]
Rule 5 (index tensor (v_2) should be within the range of input tensor)
{v_1 : tensor, v_2 : tensor} |= min(v_2) ≥ 0 ∧ ∀i ∈ [0, ndim(v_1) − 1] : max(v_2) ≤ shape(v_1, i) − 1

Rule 12 (a primitive type variable is smaller than the other)
{v_1 : int ⊎ float, v_2 : int ⊎ float} |= v_1 ≤ v_2

Rule 25 (tensor shape matches given tuple shape)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) = v_2.len ∧ ∀i ∈ [0, v_2.len - 1] : shape(v_1, i) = v_2[i]

Rule 32 (Integer indices only valid with int-compatible dtype)
{v_1 : tuple(int), v_2 : dtype} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0 ∧ v_2 = 1 ∨ v_2 = 2 ∨ v_2 = 3 ∨ v_2 = 4 ∨ v_2 = 5

Rule 7 (first dimension of a tensor matches second dimension of the other)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, 0) = shape(v_2, 1)

