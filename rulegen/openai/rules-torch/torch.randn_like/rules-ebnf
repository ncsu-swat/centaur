>>
Rule 1 (input tensor must be a valid tensor)
{v_1 : tensor} |= v_1 ≠ null
>>
Rule 3 (input tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 4 (tensor shape matches given tuple shape)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) = v_2.len ∧ ∀i ∈ [0, v_2.len - 1] : shape(v_1, i) = v_2[i]
>>
Rule 5 (tensor shape matches given list shape)
{v_1 : tensor, v_2 : list(int)} |= ndim(v_1) = v_2.len ∧ ∀i ∈ [0, v_2.len - 1] : shape(v_1, i) = v_2[i]
