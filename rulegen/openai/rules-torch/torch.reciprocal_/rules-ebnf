Rule 1 (output type should match input type)
{v_1 : tensor} |= dtype_(v_1) = "float" ∧ dtype_(v_1) ≠ "int"
>>
Rule 2 (input tensor must be non-empty)
{v_1 : tensor} |= ndim(v_1) > 0 ∧ shape(v_1, 0) > 0
>>
Rule 3 (input tensor must have valid dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 0 ∧ shape(v_1, 0) ≥ 0
>>
Rule 4 (output type should be compatible with input type)
{v_1 : tensor} |= dtype_(v_1) ≠ "char" ∧ dtype_(v_1) ≠ "int"
>>
Rule 5 (valid range for tensor dimensions)
{v_1 : tensor, v_2 : int} |= -1 × ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 6 (tensor should have consistent shape with its input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 7 (valid broadcasting dimensions for tensors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 8 (tensor must have valid input values)
{v_1 : tensor} |= ndim(v_1) > 0 ∧ shape(v_1, 0) > 0 ∧ dtype_(v_1) ≠ "char"
