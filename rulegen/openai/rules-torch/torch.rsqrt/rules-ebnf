>>
Rule 2 (input tensor elements must be non-negative)
{v_1 : tensor} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 3 (input tensor elements must be positive)
{v_1 : tensor} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 4 (input tensor should not contain zero)
{v_1 : tensor} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≠ 0
>>
Rule 5 (output tensor must be same shape as input)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 6 (output tensor should have same type as input)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 9 (input tensor must be a valid scalar tensor)
{v_1 : tensor} |= ndim(v_1) = 0 ∧ shape(v_1, 0) = 1
