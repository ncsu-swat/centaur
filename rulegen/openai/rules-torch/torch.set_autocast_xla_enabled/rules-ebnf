Rule 1 (boolean parameter must be a valid boolean value)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 2 (tensor input must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 3 (tensor input must not be empty)
{v_1 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ min(v_1) ≥ 0 ∧ max(v_1) ≤ shape(v_1, 0) - 1
>>
Rule 5 (list of integers used as axes must be valid for tensor shape)
{v_1 : tensor, v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 6 (tensor input must have a valid dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ "none"
>>
Rule 7 (tensor input must be non-negative)
{v_1 : tensor} |= min(v_1) ≥ 0
>>
Rule 8 (tensor input must have a valid shape)
{v_1 : tensor} |= shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 9 (tensor input must have a valid number of dimensions)
{v_1 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_1) < 5
>>
Rule 11 (list of floats used as weights must match tensor dimensions)
{v_1 : tensor, v_2 : list(float)} |= v_2.len = shape(v_1, 0) ∧ ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0
