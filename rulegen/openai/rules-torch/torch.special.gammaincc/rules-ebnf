Rule 1 (input tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 2 (tensor shape matches given tuple shape)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) = v_2.len ∧ ∀i ∈ [0, v_2.len - 1] : shape(v_1, i) = v_2[i]
>>
Rule 9 (4D tensor with all shape dimensions positive)
{v_1 : tensor} |= ndim(v_1) = 4 ∧ ∀i ∈ [0, 3] : shape(v_1, i) > 0
>>
Rule 21 (primitive type variable should not be zero)
{v_1 : int ⊎ float} |= v_1 ≠ 0
