>>
Rule 1 (tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 2 (integer indices are valid only if within bounds)
{v_1 : tensor, v_2 : int, v_3 : int} |= v_2 ≥ 0 ∧ v_3 ≥ 0 ∧ v_2 < ndim(v_1) ∧ v_3 < ndim(v_1)
>>
Rule 3 (tensor should not be empty in both dimensions)
{v_1 : tensor, v_2 : int, v_3 : int} |= shape(v_1, v_2) > 0 ∧ shape(v_1, v_3) > 0
>>
Rule 5 (tensor dimensions should be valid for transpose)
{v_1 : tensor, v_2 : int, v_3 : int} |= v_2 ≠ v_3 ∧ v_2 ≥ 0 ∧ v_3 ≥ 0 ∧ v_2 < ndim(v_1) ∧ v_3 < ndim(v_1)
