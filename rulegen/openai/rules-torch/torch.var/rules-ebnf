Rule 4 (keepdim must be a boolean)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 10 (input tensor should not be empty)
{v_1 : tensor} |= shape(v_1, 0) > 0
>>
Rule 18 (Input tensor must have a dimension greater than 0)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 20 (correction must be a positive integer)
{v_1 : int} |= v_1 > 0
>>
Rule 21 (When keepdim is true, dim should not be empty)
{v_1 : int, v_2 : tuple(int)} |= keepdim = true ∧ (v_1 != None ∧ (ndim(v_2) > 0))
>>
Rule 24 (correction value must be less than or equal to the smallest dimension size of the input tensor)
{v_1 : tensor, v_2 : int} |= ∀i ∈ [0, ndim(v_1) - 1] : v_2 <= shape(v_1, i)
>>
Rule 37 (Dim should not be out of range)
{v_1 : tensor, v_2 : int} |= dim != None ∧ v_2 >= 0 ∧ v_2 < ndim(v_1)
>>
Rule 45 (Dimension within bounds)
{v_1 : tensor, v_2 : int} |= dim = None ∨ (v_2 >= 0 ∧ v_2 < ndim(v_1))
