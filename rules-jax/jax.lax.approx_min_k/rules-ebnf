{v_1 : tensor, v_2 : int, v_3 : int} |= (v_3 ≥ 0 ∧ v_2 ≤ shape(v_1, v_3)) ∨ (v_3 < 0 ∧ v_2 ≤ shape(v_1, ndim(v_1) + v_3))
