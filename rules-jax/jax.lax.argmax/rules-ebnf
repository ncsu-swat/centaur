Rule 1 (valid axis range for operand)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 1 ∧ v_2 ≥ 0 - ndim(v_1) ∧ v_2 < ndim(v_1)
>>
Rule 2 (index_dtype must be int32 or int64)
{v_3 : dtype} |= v_3 = 3 ∨ v_3 = 4
>>
Rule 3 (axis for 1D tensor must be 0 or -1)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then v_2 = 0 ∨ v_2 = 0 - 1
>>
Rule 4 (reduced dimension must have size greater than 0)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 then shape(v_1, v_2) > 0 else shape(v_1, ndim(v_1) + v_2) > 0
>>
Rule 5 (operand must not be a complex type)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
