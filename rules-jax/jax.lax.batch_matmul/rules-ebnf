Rule 1 (input tensors must have at least 2 dimensions for batch matrix multiplication)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2
>>
Rule 2 (input tensors must have matching number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 3 (contracting dimensions of lhs and rhs must align)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 4 (batch dimensions of lhs and rhs must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 3 then ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) = shape(v_2, i)) else ndim(v_1) = ndim(v_2)
>>
Rule 5 (precision tuple, if provided, must contain exactly two elements)
{v_3 : tuple(str)} |= v_3.len = 2
>>
Rule 6 (input tensors must have identical data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 7 (precision as string must be one of the permitted JAX precision values)
{v_3 : str} |= v_3 = "highest" ∨ v_3 = "float32" ∨ v_3 = "bfloat16"
>>
Rule 8 (precision as a tuple must contain exactly two valid precision strings)
{v_3 : tuple(str)} |= v_3.len = 2 ∧ ∀i ∈ [0, v_3.len - 1] : v_3[i] = "highest" ∨ v_3[i] = "float32" ∨ v_3[i] = "bfloat16"
>>
Rule 10 (the contraction dimensions of the batch inputs must match)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 12 (all batch dimensions of the input tensors must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 3 ∧ ndim(v_2) ≥ 3 ∧ ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) = shape(v_2, i)
>>
Rule 14 (no dimension of the batch matmul input should be zero)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 16 (precision tuple must be of length 2 and contain recognized precision strings)
{v_3 : tuple(str)} |= v_3.len = 2 ∧ (v_3[0] = "highest" ∨ v_3[0] = "float32" ∨ v_3[0] = "bfloat16") ∧ (v_3[1] = "highest" ∨ v_3[1] = "float32" ∨ v_3[1] = "bfloat16")
>>
Rule 17 (batch dimensions of LHS and RHS must match exactly)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 3 then ndim(v_2) ≥ 3 ∧ (∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) = shape(v_2, i))
