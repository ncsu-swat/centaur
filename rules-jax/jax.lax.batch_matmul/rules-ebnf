{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 3 then ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) = shape(v_2, i)) else ndim(v_1) = ndim(v_2)
