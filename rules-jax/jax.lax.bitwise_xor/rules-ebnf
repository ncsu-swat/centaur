Rule 1 (tensors x and y must have matching dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (input tensor x must have boolean or integer dtype)
{v_1 : tensor} |= dtype_(v_1) ≤ 5
>>
Rule 3 (tensors x and y must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 4 (tensors x and y must be broadcast compatible)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ (shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)))
>>
Rule 5 (dimensions of input tensors must be greater than zero)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 8 (if neither tensor is a scalar, they must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ndim(v_1) = ndim(v_2)
>>
Rule 9 (if neither tensor is a scalar, they must be broadcast compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 10 (input tensor must have positive dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 11 (dimension equality when both are non-scalars)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 0 ∨ ndim(v_2) = 0 ∨ ndim(v_1) = ndim(v_2)
>>
Rule 12 (broadcast compatibility when dimensions are equal)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 13 (tensors must have matching integer or boolean dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) < 6 ∧ dtype_(v_1) = dtype_(v_2)
>>
Rule 14 (all shape dimensions must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 1
>>
Rule 15 (input tensors must have at most 8 dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≤ 8 ∧ ndim(v_2) ≤ 8
>>
Rule 17 (input x must have a boolean or integer dtype)
{v_1 : tensor} |= dtype_(v_1) = 0 ∨ (dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5)
>>
Rule 19 (shapes of inputs must be broadcast-compatible when they have the same rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
