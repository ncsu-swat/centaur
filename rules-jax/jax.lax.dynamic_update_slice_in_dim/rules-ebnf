Rule 1 (operand and update must have the same dimensionality)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 2 (update shape must not exceed operand shape in any dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) ≤ shape(v_1, i)
>>
Rule 3 (axis must be a non-negative integer within the dimension bounds of the operand)
{v_1 : tensor, v_4 : int} |= v_4 ≥ 0 ∧ v_4 < ndim(v_1)
>>
Rule 4 (operand and update must have the same data type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 5 (start_index as a tensor must be 0-dimensional scalar)
{v_3 : tensor} |= ndim(v_3) = 0
>>
Rule 6 (axis parameter must be 0 when operand is a 1D tensor)
{v_1 : tensor, v_4 : int} |= ndim(v_1) = 1 ∧ v_4 = 0
>>
Rule 10 (axis must be within the valid range of operand dimensions)
{v_1 : tensor, v_4 : int} |= v_4 ≥ 0 - ndim(v_1) ∧ v_4 < ndim(v_1)
>>
Rule 11 (start_index as a tensor must be 0-dimensional with integer type)
{v_3 : tensor} |= ndim(v_3) = 0 ∧ dtype_(v_3) ≥ 1 ∧ dtype_(v_3) ≤ 5
>>
Rule 12 (if allow_negative_indices is false, integer start_index must be non-negative)
{v_3 : int, v_5 : bool} |= if v_5 = false then v_3 ≥ 0
>>
Rule 13 (if allow_negative_indices is false, tensor start_index must contain non-negative values)
{v_3 : tensor, v_5 : bool} |= ndim(v_3) = 0 ∧ if v_5 = false then min(v_3) ≥ 0
>>
Rule 14 (update slice shape on the target axis must not exceed operand shape)
{v_1 : tensor, v_2 : tensor, v_4 : int} |= ndim(v_1) = ndim(v_2) ∧ if v_4 ≥ 0 ∧ v_4 < ndim(v_1) then shape(v_2, v_4) ≤ shape(v_1, v_4)
