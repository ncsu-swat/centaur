Rule 1 (tensors must have matching data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (non-scalar tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ndim(v_1) = ndim(v_2)
>>
Rule 3 (non-scalar tensors must be broadcast compatible along each dimension)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 5 (tensor data type must be a valid primitive type)
{v_1 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 8 (all dimension sizes of an input tensor must be non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 10 (either input is a scalar or both inputs share the same rank)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 0 ∨ ndim(v_2) = 0 ∨ ndim(v_1) = ndim(v_2)
>>
Rule 11 (tensors with matching rank must have compatible broadcast dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 13 (inputs of identical shape are elementwise comparable)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 17 (all dimension sizes of an input tensor must be strictly positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 18 (tensor rank must be non-negative)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 19 (tensor minimum value cannot exceed its maximum value)
{v_1 : tensor} |= min(v_1) ≤ max(v_1)
>>
Rule 20 (leading dimension of non-scalar inputs must be broadcast compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 21 (trailing dimension of same-rank tensors must be broadcast compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ndim(v_1) = ndim(v_2) then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 22 (all dimension sizes of a non-scalar tensor must be strictly positive)
{v_1 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 23 (tensor data type cannot be string or dtype object)
{v_1 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 12
>>
Rule 24 (if one input tensor is boolean, the other must also be boolean)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 then dtype_(v_2) = 0
>>
Rule 25 (if one input tensor is an integer type, the other must also be an integer type)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5
>>
Rule 26 (if one input tensor is a floating-point type, the other must also be a floating-point type)
{v_1 : tensor, v_2 : tensor} |= if 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 then 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 27 (1-dimensional tensors must have matching or broadcastable size)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 28 (second dimension of multidimensional tensors must be broadcast compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 1 ∧ ndim(v_2) > 1 then shape(v_1, 1) = shape(v_2, 1) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 1) = 1
>>
Rule 29 (if one input tensor is a complex type, the other must also be a complex type)
{v_1 : tensor, v_2 : tensor} |= if 9 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 then 9 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10
>>
Rule 30 (if one input tensor has unsigned integer dtype, the other must also have unsigned integer dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 5 then dtype_(v_2) = 5
>>
Rule 31 (third dimension of tensors with rank greater than 2 must be broadcast compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 ∧ ndim(v_2) > 2 then shape(v_1, 2) = shape(v_2, 2) ∨ shape(v_1, 2) = 1 ∨ shape(v_2, 2) = 1
>>
Rule 32 (when comparing a scalar tensor to a non-scalar tensor, all dimensions of the non-scalar tensor must be positive)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∧ ndim(v_2) > 0 then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 33 (boolean primitive input must be either true or false)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
