Rule 1 (matching dtypes for tensor inputs)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (rank and broadcast compatibility for non-scalar tensor inputs)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 4 (rank and broadcast compatibility for tensor inputs)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 5 (valid dtype range for tensor inputs)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≤ 10
>>
Rule 6 (non-string and non-dtype tensor type for elementwise maximum)
{v_1 : tensor} |= dtype_(v_1) ≤ 10
>>
Rule 8 (broadcasting compatibility and rank equality for non-scalar tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1 ∨ shape(v_2, i) = 1 ∨ shape(v_1, i) = shape(v_2, i))
>>
Rule 9 (input tensor must have a valid boolean, integer, float, or complex dtype)
{v_1 : tensor} |= dtype_(v_1) ≥ 0 ∧ dtype_(v_1) ≤ 10
>>
Rule 15 (tensor dimensions should have size greater than 0)
{v_1 : tensor} |= if ndim(v_1) > 0 then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0)
>>
Rule 16 (compatibility of float inputs)
{v_1 : float, v_2 : float} |= v_1 < v_2 ∨ v_1 ≥ v_2
>>
Rule 17 (compatibility of integer inputs)
{v_1 : int, v_2 : int} |= v_1 < v_2 ∨ v_1 ≥ v_2
>>
Rule 18 (compatibility of boolean inputs)
{v_1 : bool, v_2 : bool} |= (v_1 = true ∨ v_1 = false) ∧ (v_2 = true ∨ v_2 = false)
