{v_1 : tensor, v_2 : tuple(int) ⊎ list(int)} |= if ndim(v_1) = 1 ∧ v_2.len = 2 ∧ v_2[0] = 1 then v_2[1] = shape(v_1, 0)
>>
Rule 132 (dimension permutation must have the same length as operand dimensions)
{v_1 : tensor, v_3 : list(int) ⊎ tuple(int)} |= v_3.len = ndim(v_1)
>>
Rule 133 (permutation dimensions must be within valid range of input tensor axes)
{v_1 : tensor, v_3 : list(int) ⊎ tuple(int)} |= ∀i ∈ [0, v_3.len - 1] : v_3[i] ≥ 0 ∧ v_3[i] < ndim(v_1)
>>
Rule 134 (new sizes must contain 0 if input tensor is empty, otherwise must be strictly positive)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int)} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then (∃j ∈ [0, v_2.len - 1] : v_2[j] = 0) else (∀j ∈ [0, v_2.len - 1] : v_2[j] > 0)
>>
Rule 135 (all elements in new sizes must be non-negative)
{v_2 : list(int) ⊎ tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0
>>
Rule 138 (The permutation dimensions must contain unique indices to represent a valid permutation)
{v_3 : list(int) ⊎ tuple(int)} |= ∀i ∈ [0, v_3.len - 1] : (∀j ∈ [0, v_3.len - 1] : i = j ∨ v_3[i] ≠ v_3[j])
>>
Rule 140 (If both the input and output are 1-dimensional, their dimension sizes must be identical)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int)} |= if ndim(v_1) = 1 ∧ v_2.len = 1 then shape(v_1, 0) = v_2[0]
>>
Rule 141 (Reshaping a 2D tensor to 1D requires the new size to be the product of the original dimensions)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int)} |= if ndim(v_1) = 2 ∧ v_2.len = 1 then v_2[0] = shape(v_1, 0) * shape(v_1, 1)
>>
Rule 142 (Reshaping a 1D tensor to 2D requires the product of the new sizes to equal the original dimension)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int)} |= if ndim(v_1) = 1 ∧ v_2.len = 2 then v_2[0] * v_2[1] = shape(v_1, 0)
>>
Rule 143 (If the input is a 0-dimensional scalar, all dimensions in the target shape must be equal to 1)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int)} |= if ndim(v_1) = 0 then ∀i ∈ [0, v_2.len - 1] : v_2[i] = 1
>>
Rule 144 (All elements in the permutation dimensions list must be unique)
{v_3 : list(int) ⊎ tuple(int)} |= ∀i ∈ [0, v_3.len - 1] : ∀j ∈ [0, v_3.len - 1] : i = j ∨ v_3[i] ≠ v_3[j]
>>
Rule 149 (The permutation dimensions list must cover all axes of the input tensor)
{v_1 : tensor, v_3 : list(int) ⊎ tuple(int)} |= ∀d ∈ [0, ndim(v_1) - 1] : ∃i ∈ [0, v_3.len - 1] : v_3[i] = d
>>
Rule 150 (Reshaping to a 0-dimensional shape requires all dimensions of the input tensor to be equal to 1)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int)} |= if v_2.len = 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1
>>
Rule 152 (permutation dimensions must be valid axis indices)
{v_1 : tensor, v_3 : tuple(int) ⊎ list(int)} |= ∀i ∈ [0, v_3.len - 1] : (v_3[i] ≥ 0 ∧ v_3[i] < ndim(v_1))
>>
Rule 153 (permutation dimensions must contain unique indices)
{v_3 : tuple(int) ⊎ list(int)} |= ∀i ∈ [0, v_3.len - 1] : (∀j ∈ [0, v_3.len - 1] : (if i ≠ j then v_3[i] ≠ v_3[j]))
>>
Rule 156 (if new_sizes contains zero, operand must contain zero in its shape)
{v_1 : tensor, v_2 : tuple(int) ⊎ list(int)} |= if (∃i ∈ [0, v_2.len - 1] : v_2[i] = 0) then (∃j ∈ [0, ndim(v_1) - 1] : shape(v_1, j) = 0)
>>
Rule 160 (if the input tensor is a scalar, the target shape can only contain dimensions of size 1)
{v_1 : tensor, v_2 : tuple(int) ⊎ list(int)} |= if ndim(v_1) = 0 then (v_2.len = 0 ∨ ∀i ∈ [0, v_2.len - 1] : v_2[i] = 1)
>>
Rule 161 (if the target shape is empty, the input tensor must have size 1)
{v_1 : tensor, v_2 : tuple(int) ⊎ list(int)} |= if v_2.len = 0 then (ndim(v_1) = 0 ∨ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1)
