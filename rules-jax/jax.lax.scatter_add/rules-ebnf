Rule 1 (operand and updates must have the same data type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (mode must be one of the supported scatter handling modes)
{v_1 : str} |= v_1 = "clip" ∨ v_1 = "drop" ∨ v_1 = "fill" ∨ v_1 = "promise_in_bounds"
>>
Rule 3 (scatter indices must have an integer data type)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5
>>
Rule 4 (operand tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 5 (last dimension of scatter indices cannot exceed the operand rank)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ shape(v_1, ndim(v_1) - 1) ≤ ndim(v_2)
>>
Rule 6 (dimension numbers indexing into operand dimensions must be within operand rank)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 7 (when mode is promise_in_bounds indices must be non-negative)
{v_1 : str, v_2 : tensor} |= if v_1 = "promise_in_bounds" then min(v_2) ≥ 0
>>
Rule 8 (updates tensor must have rank at least scatter indices rank minus one)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ ndim(v_1) - 1
>>
Rule 9 (operand tensor must have a numeric data type: integer, float, or complex)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 10 (dimension numbers elements must be non-negative)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 11 (dimension numbers length cannot exceed operand rank)
{v_1 : tuple(int), v_2 : tensor} |= v_1.len ≤ ndim(v_2)
>>
Rule 12 (leading batch dimensions of scatter indices and updates must match)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ ndim(v_1) - 1 ∧ ∀i ∈ [0, ndim(v_1) - 2] : shape(v_1, i) = shape(v_2, i)
>>
Rule 13 (all dimensions of the operand tensor must be strictly positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 14 (boolean flags may be boolean or binary integer indicators)
{v_1 : bool ⊎ int} |= v_1 = true ∨ v_1 = false ∨ v_1 = 0 ∨ v_1 = 1
>>
Rule 15 (if mode is promise_in_bounds then maximum index must be within the first dimension of operand)
{v_1 : str, v_2 : tensor, v_3 : tensor} |= if v_1 = "promise_in_bounds" ∧ ndim(v_3) > 0 then max(v_2) < shape(v_3, 0)
>>
Rule 16 (window dimensions in dimension numbers must not exceed updates rank)
{v_1 : tuple(int), v_2 : tensor} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] < ndim(v_2)
>>
Rule 17 (when operand and scatter indices are 1D updates must be 1D and match scatter indices length)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then ndim(v_3) = 1 ∧ shape(v_3, 0) = shape(v_2, 0)
>>
Rule 18 (all dimension sizes of updates tensor must be strictly positive)
{v_1 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 19 (length of dimension numbers cannot exceed the combined rank of operand and updates)
{v_1 : tuple(int), v_2 : tensor, v_3 : tensor} |= v_1.len ≤ ndim(v_2) + ndim(v_3)
>>
Rule 20 (optimization flags must evaluate to valid boolean truth values)
{v_1 : bool, v_2 : bool} |= (v_1 = true ∨ v_1 = false) ∧ (v_2 = true ∨ v_2 = false)
>>
Rule 21 (when operand and updates have equal rank updates slice sizes cannot exceed operand dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) ≤ shape(v_1, i)
>>
Rule 22 (minimum scatter index must not exceed maximum scatter index)
{v_1 : tensor} |= min(v_1) ≤ max(v_1)
>>
Rule 23 (if operand has a floating-point data type updates must also be floating-point)
{v_1 : tensor, v_2 : tensor} |= if 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 then 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 24 (when indices are sorted the scatter indices bounds must be consistent)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then min(v_2) ≤ max(v_2)
>>
Rule 25 (updates tensor rank cannot exceed the combined ranks of operand and scatter indices)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_3) ≤ ndim(v_1) + ndim(v_2)
>>
Rule 26 (if operand is an integer data type updates must also have an integer data type)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5
>>
Rule 27 (mode string must not specify activation function names)
{v_1 : str} |= v_1 ≠ "relu" ∧ v_1 ≠ "tanh" ∧ v_1 ≠ "sigmoid"
>>
Rule 28 (when operand and scatter indices are 2D the index depth cannot exceed operand rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_2, 1) ≤ 2
>>
Rule 29 (complex operand requires complex updates)
{v_1 : tensor, v_2 : tensor} |= if 9 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 then 9 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10
>>
Rule 30 (scatter indices tensor must not have a floating-point data type)
{v_1 : tensor} |= dtype_(v_1) < 6 ∨ dtype_(v_1) > 8
>>
Rule 31 (scalar operand requires index dimension of size zero for multidimensional scatter indices)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∧ ndim(v_2) ≥ 1 then shape(v_2, ndim(v_2) - 1) = 0
>>
Rule 32 (all dimension numbers entries must be strictly less than the combined ranks of operand and updates)
{v_1 : tuple(int), v_2 : tensor, v_3 : tensor} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] < ndim(v_2) + ndim(v_3)
>>
Rule 33 (scatter indices tensor must not have a boolean data type)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 34 (when operand is 1D and scatter indices is 2D the index depth must be 1)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 2 then shape(v_2, 1) = 1
>>
Rule 35 (first entry of a non-empty dimension numbers tuple must be non-negative)
{v_1 : tuple(int)} |= if v_1.len > 0 then v_1[0] ≥ 0
>>
