Rule 2 (if neither input is a scalar, they must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ndim(v_1) = ndim(v_2)
>>
Rule 3 (if neither input is a scalar, their dimensions must be broadcast compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 7 (inputs must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 8 (both inputs must have integer dtypes)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5) ∧ (dtype_(v_2) ≥ 1 ∧ dtype_(v_2) ≤ 5)
>>
Rule 9 (if both inputs are non-scalars, they must have the same rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≠ 0 ∧ ndim(v_2) ≠ 0 then ndim(v_1) = ndim(v_2)
>>
Rule 10 (if dimensions match, inputs must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 11 (shift amount should be non-negative when it is scalar)
{v_2 : tensor} |= if ndim(v_2) = 0 then min(v_2) ≥ 0
>>
Rule 12 (both inputs must have matching integer dtypes)
{v_1 : tensor, v_2 : tensor} |= ((dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) ∧ dtype_(v_1) = dtype_(v_2))
>>
Rule 13 (1D broadcast compatibility for elementwise right shift)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1)
>>
Rule 16 (broadcasting compatibility on shapes when both are non-scalars)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 17 (dimension compatibility when neither is a scalar)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 0 ∨ ndim(v_2) = 0 ∨ ndim(v_1) = ndim(v_2)
>>
Rule 18 (shift amount must be non-negative)
{v_2 : tensor} |= min(v_2) ≥ 0
>>
Rule 19 (shift amount cannot exceed bit width of the integer dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 1 ∨ dtype_(v_1) = 5 then max(v_2) < 8 else (if dtype_(v_1) = 2 then max(v_2) < 16 else (if dtype_(v_1) = 3 then max(v_2) < 32 else (if dtype_(v_1) = 4 then max(v_2) < 64)))
