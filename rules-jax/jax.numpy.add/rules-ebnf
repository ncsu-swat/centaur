Rule 10 (Dtype compatibility and element-wise range constraint)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = dtype_(v_2)) ∧ (min(v_1) + min(v_2) ≤ max(v_1) + max(v_2))
>>
Rule 11 (Tensor and float scalar addition range consistency)
{v_1 : tensor, v_2 : float} |= min(v_1) + v_2 ≤ max(v_1) + v_2
>>
Rule 12 (Float scalar and tensor addition range consistency)
{v_1 : float, v_2 : tensor} |= v_1 + min(v_2) ≤ v_1 + max(v_2)
>>
Rule 13 (Tensor and integer scalar addition range consistency)
{v_1 : tensor, v_2 : int} |= min(v_1) + v_2 ≤ max(v_1) + v_2
>>
Rule 14 (Integer scalar and tensor addition range consistency)
{v_1 : int, v_2 : tensor} |= v_1 + min(v_2) ≤ v_1 + max(v_2)
>>
Rule 16 (tensors of the same rank must have broadcast-compatible shapes)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
