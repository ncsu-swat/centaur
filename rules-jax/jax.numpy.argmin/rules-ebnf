Rule 6 (input tensor must not be empty and must have dimension sizes greater than zero)
{v_1 : tensor} |= ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 7 (axis reduction dimension must be greater than 0 to prevent empty reduction)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 then shape(v_1, v_2) > 0 else shape(v_1, v_2 + ndim(v_1)) > 0
>>
Rule 8 (input tensor must have a non-complex data type)
{v_1 : tensor} |= dtype_(v_1) < 9
>>
Rule 9 (for a 1D tensor, the axis can only be 0 or -1)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then v_2 = 0 ∨ v_2 = 0 - 1
