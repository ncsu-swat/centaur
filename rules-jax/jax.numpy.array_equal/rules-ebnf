{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if (dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5) ∧ (dtype_(v_2) ≥ 1 ∧ dtype_(v_2) ≤ 5) then v_3 = false
>>
