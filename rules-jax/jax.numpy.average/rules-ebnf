>>
Rule 1 (axis integer must be within the valid range of tensor a's dimensions)
{v_1 : tensor, v_2 : int} |= 0 - ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 2 (all elements of axis tuple must be within the valid range of tensor a's dimensions)
{v_1 : tensor, v_2 : tuple(int)} |= ∀ i ∈ [0, v_2.len - 1] : 0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] ≤ ndim(v_1) - 1
>>
Rule 3 (all elements of axis list must be within the valid range of tensor a's dimensions)
{v_1 : tensor, v_2 : list(int)} |= ∀ i ∈ [0, v_2.len - 1] : 0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] ≤ ndim(v_1) - 1
>>
Rule 4 (weights shape must match a's shape or correspond to the 1D dimension at axis to prevent mismatch errors)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= (ndim(v_3) = ndim(v_1) ∧ (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i))) ∨ (ndim(v_3) = 1 ∧ (if v_2 ≥ 0 then shape(v_3, 0) = shape(v_1, v_2) else shape(v_3, 0) = shape(v_1, v_2 + ndim(v_1))))
>>
Rule 5 (weights shape must match a's shape or the shape defined by the tuple of reduction axes)
{v_1 : tensor, v_2 : tuple(int), v_3 : tensor} |= (ndim(v_3) = ndim(v_1) ∧ (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i))) ∨ (ndim(v_3) = v_2.len ∧ (∀ i ∈ [0, v_2.len - 1] : if v_2[i] ≥ 0 then shape(v_3, i) = shape(v_1, v_2[i]) else shape(v_3, i) = shape(v_1, v_2[i] + ndim(v_1))))
>>
Rule 6 (axis tuple length should not exceed tensor rank)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≤ ndim(v_1) ∧ v_2.len ≥ 1
>>
Rule 7 (input tensor a must have a numeric dtype)
{v_1 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 8 (shapes of a and weights must match when axis is not specified)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 12 (weights tensor shape must match tensor a or match the single reduction axis)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= (ndim(v_1) = ndim(v_3) ∧ (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_3, i))) ∨ (ndim(v_3) = 1 ∧ (if v_2 ≥ 0 then shape(v_3, 0) = shape(v_1, v_2) else shape(v_3, 0) = shape(v_1, v_2 + ndim(v_1))))
>>
Rule 13 (weights tensor shape must match tensor a or match the dimensions in axis tuple)
{v_1 : tensor, v_2 : tuple(int), v_3 : tensor} |= (ndim(v_1) = ndim(v_3) ∧ (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_3, i))) ∨ (ndim(v_3) = v_2.len ∧ (∀ i ∈ [0, v_2.len - 1] : if v_2[i] ≥ 0 then shape(v_3, i) = shape(v_1, v_2[i]) else shape(v_3, i) = shape(v_1, v_2[i] + ndim(v_1))))
>>
Rule 15 (input array and weights must have numeric data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≤ 10
>>
Rule 18 (when shapes of a and weights differ with list axis, weights shape must match the list of axes)
{v_1 : tensor, v_2 : list(int), v_3 : tensor} |= (ndim(v_1) = ndim(v_3) ∧ (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_3, i))) ∨ (ndim(v_3) = v_2.len ∧ (∀ i ∈ [0, v_2.len - 1] : if v_2[i] ≥ 0 then shape(v_3, i) = shape(v_1, v_2[i]) else shape(v_3, i) = shape(v_1, v_2[i] + ndim(v_1))))
>>
Rule 19 (axes specified in axis tuple must all be distinct)
{v_1 : tuple(int)} |= ∀ i ∈ [0, v_1.len - 1] : ∀ j ∈ [0, v_1.len - 1] : i = j ∨ v_1[i] ≠ v_1[j]
>>
Rule 20 (axes specified in axis list must all be distinct)
{v_1 : list(int)} |= ∀ i ∈ [0, v_1.len - 1] : ∀ j ∈ [0, v_1.len - 1] : i = j ∨ v_1[i] ≠ v_1[j]
>>
Rule 22 (when shapes of a and weights differ with integer axis, weights must be 1D matching dimension of a along axis)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= if ndim(v_3) = 1 then (if v_2 ≥ 0 then shape(v_3, 0) = shape(v_1, v_2) else shape(v_3, 0) = shape(v_1, v_2 + ndim(v_1))) else (ndim(v_3) = ndim(v_1) ∧ (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)))
>>
Rule 23 (when shapes of a and weights differ with tuple axis, weights shape must match the tuple of axes)
{v_1 : tensor, v_2 : tuple(int), v_3 : tensor} |= if ndim(v_3) = v_2.len then (∀ i ∈ [0, v_2.len - 1] : if v_2[i] ≥ 0 then shape(v_3, i) = shape(v_1, v_2[i]) else shape(v_3, i) = shape(v_1, v_2[i] + ndim(v_1))) else (ndim(v_3) = ndim(v_1) ∧ (∀ j ∈ [0, ndim(v_1) - 1] : shape(v_3, j) = shape(v_1, j)))
>>
Rule 24 (when shapes of a and weights differ with list axis, weights shape must match the list of axes)
{v_1 : tensor, v_2 : list(int), v_3 : tensor} |= if ndim(v_3) = v_2.len then (∀ i ∈ [0, v_2.len - 1] : if v_2[i] ≥ 0 then shape(v_3, i) = shape(v_1, v_2[i]) else shape(v_3, i) = shape(v_1, v_2[i] + ndim(v_1))) else (ndim(v_3) = ndim(v_1) ∧ (∀ j ∈ [0, ndim(v_1) - 1] : shape(v_3, j) = shape(v_1, j)))
>>
Rule 25 (if a and weights have the same rank their shapes must match otherwise weights must be 1D)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)) else ndim(v_2) = 1
>>
Rule 26 (axis sequence must contain at least one dimension)
{v_1 : tuple(int) ⊎ list(int)} |= v_1.len ≥ 1
>>
