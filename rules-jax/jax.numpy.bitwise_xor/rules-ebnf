{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 26 (First tensor operand cannot have float16 or float32 dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 6 ∧ dtype_(v_1) ≠ 7
>>
Rule 27 (Neither operand may have floating-point or higher dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) ≥ 6 ∨ dtype_(v_2) ≥ 6 then false
>>
Rule 28 (Broadcasting when first tensor has fewer dimensions than second tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < ndim(v_2) then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1
>>
Rule 29 (Broadcasting when second tensor has fewer dimensions than first tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) < ndim(v_1) then shape(v_2, ndim(v_2) - 1) = shape(v_1, ndim(v_1) - 1) ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 30 (Broadcasting compatibility for 2D tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1) ∧ (shape(v_1, 1) = shape(v_2, 1) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 1) = 1)
