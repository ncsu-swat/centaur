Rule 22 (Both tensor operands must not have float32 dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 7 ∧ dtype_(v_2) ≠ 7
>>
Rule 23 (1D first operand must broadcast with the trailing dimension of second operand)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 24 (1D second operand must broadcast with the trailing dimension of first operand)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 1 then shape(v_2, 0) = shape(v_1, ndim(v_1) - 1) ∨ shape(v_2, 0) = 1 ∨ shape(v_1, ndim(v_1) - 1) = 1
>>
