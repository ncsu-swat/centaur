Rule 1 (broadcast compatibility between min and max tensors of same ndim)
{v_2 : tensor, v_3 : tensor} |= ndim(v_2) = ndim(v_3) ∧ ∀ i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = shape(v_3, i) ∨ shape(v_2, i) = 1 ∨ shape(v_3, i) = 1
>>
Rule 2 (tensor arr should have a numeric data type)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 3 (min value should be less than or equal to max value for numeric scalar limits)
{v_2 : int ⊎ float, v_3 : int ⊎ float} |= v_2 ≤ v_3
>>
Rule 4 (arr and min as tensors must be broadcast-compatible if they have the same dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 5 (arr must not have any zero-sized dimensions)
{v_1 : tensor} |= ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 6 (broadcast compatibility of min tensor with arr tensor when ndim(arr) >= ndim(min))
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ ndim(v_2) then ∀ i ∈ [0, ndim(v_2) - 1] : shape(v_2, ndim(v_2) - 1 - i) = shape(v_1, ndim(v_1) - 1 - i) ∨ shape(v_2, ndim(v_2) - 1 - i) = 1 else false
>>
Rule 7 (broadcast compatibility of max tensor with arr tensor when ndim(arr) >= ndim(max))
{v_1 : tensor, v_3 : tensor} |= if ndim(v_1) ≥ ndim(v_3) then ∀ i ∈ [0, ndim(v_3) - 1] : shape(v_3, ndim(v_3) - 1 - i) = shape(v_1, ndim(v_1) - 1 - i) ∨ shape(v_3, ndim(v_3) - 1 - i) = 1 else false
>>
Rule 8 (arr must have a valid numerical or boolean data type)
{v_1 : tensor} |= dtype_(v_1) ≤ 10
>>
Rule 9 (if min and max are floats, min must be less than or equal to max)
{v_2 : float, v_3 : float} |= v_2 ≤ v_3
>>
Rule 10 (if min and max are integers, min must be less than or equal to max)
{v_2 : int, v_3 : int} |= v_2 ≤ v_3
