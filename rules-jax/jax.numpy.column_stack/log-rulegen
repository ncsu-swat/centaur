    {v_1 : int ⊎ float} |= v_1 ≠ 0

[Example Rules]
Rule 28 (list of ints used as dimensions/axes, all non-negative and valid for tensor shape)
{v_1 : tensor, v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1)

Rule 3 (input tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)

Rule 7 (first dimension of a tensor matches second dimension of the other)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, 0) = shape(v_2, 1)

