Rule 1 (valid axis range for a single tensor input)
{v_1 : tensor, v_2 : int} |= 0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 2 (input list of tensors must not be empty)
{v_1 : list(tensor)} |= v_1.len > 0
>>
Rule 3 (single tensor input must have at least 1 dimension to be concatenated/unstacked)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 4 (all shape dimensions of the input tensor must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 5 (Valid axis range for a single tensor input)
{v_1 : tensor, v_2 : int} |= -1 * ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 7 (The sequence of arrays to concatenate must be non-empty)
{v_1 : list(tensor)} |= v_1.len ≥ 1
>>
Rule 8 (Normalized axis index must be non-negative and within bounds)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then ndim(v_1) + v_2 ≥ 0 else v_2 < ndim(v_1)
>>
Rule 10 (Valid axis boundaries for single tensor)
{v_1 : tensor, v_2 : int} |= v_2 < ndim(v_1) ∧ 0 - ndim(v_1) ≤ v_2
>>
Rule 11 (Normalized positive axis has at least size 1 for unstacking)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 ∧ v_2 < ndim(v_1) then shape(v_1, v_2) ≥ 1
>>
Rule 12 (Normalized negative axis has at least size 1 for unstacking)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 ∧ v_2 ≥ 0 - ndim(v_1) then shape(v_1, ndim(v_1) + v_2) ≥ 1
>>
Rule 14 (If the input tensor is 1D, the axis must be 0 or -1)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then v_2 = 0 ∨ v_2 = -1
