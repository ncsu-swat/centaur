{v_1 : tensor, v_2 : int, v_3 : int} |= ndim(v_1) ≥ 2 ∧ v_2 ≥ 0 ∧ v_2 < ndim(v_1) ∧ v_3 ≥ 0 ∧ v_3 < ndim(v_1) ∧ v_2 ≠ v_3
