{v_1 : tensor, v_3 : int, v_4 : tensor} |= if ndim(v_4) = ndim(v_1) then ∀i ∈ [0, ndim(v_1) - 1] : if i ≠ v_3 ∧ i ≠ v_3 + ndim(v_1) then shape(v_4, i) = shape(v_1, i)
