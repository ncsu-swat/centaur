Rule 1 (input tensors should have the same shape for element-wise division)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 2 (divisor tensor must have broadcast-compatible dimensions with dividend tensor when both are 1D)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1)
>>
Rule 3 (divisor scalar must not be zero)
{v_2 : int ⊎ float} |= v_2 ≠ 0
>>
Rule 4 (both input tensors must have at least 1 dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 5 (identical shape constraint for division of tensors of the same dimension)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 6 (1D divisor tensor broadcasting compatibility)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 1 ∧ ndim(v_1) ≥ 1 then shape(v_2, 0) = shape(v_1, ndim(v_1) - 1) ∨ shape(v_2, 0) = 1
>>
Rule 7 (divisor tensor elements must be strictly non-zero)
{v_2 : tensor} |= min(v_2) > 0 ∨ max(v_2) < 0
>>
Rule 8 (floating-point dtype constraint for division inputs)
{v_1 : tensor, v_2 : tensor} |= (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) ∧ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8)
>>
Rule 9 (0-dimensional divisor must be non-zero)
{v_2 : tensor} |= if ndim(v_2) = 0 then min(v_2) ≠ 0
>>
Rule 10 (1D tensors broadcast compatibility for element-wise division)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 1 ∧ ndim(v_2) = 1) then (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1)
>>
Rule 11 (broadcast compatibility for 2D dividend and 1D divisor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 1 then shape(v_2, 0) = shape(v_1, 1)
>>
