{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 3 ∧ ndim(v_2) = 2 then shape(v_1, 2) = shape(v_2, 1) ∧ shape(v_1, 1) = shape(v_2, 0)
>>
Rule 13 (identical data type requirement for integer tensor division)
{v_1 : tensor, v_2 : tensor} |= if (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) ∧ (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5) then dtype_(v_1) = dtype_(v_2)
