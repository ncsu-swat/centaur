Rule 6 (element-wise shape compatibility for tensor inputs)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 8 (divisor tensor elements should be strictly positive or strictly negative to avoid division by zero)
{v_2 : tensor} |= min(v_2) > 0 ∨ max(v_2) < 0
>>
Rule 11 (dividend tensor dimension should be greater than or equal to divisor tensor dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ ndim(v_2)
>>
Rule 12 (trailing dimensions of both tensors must match for element-wise operation alignment)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 14 (strictly positive scalar divisor)
{v_2 : int ⊎ float} |= v_2 > 0
>>
Rule 15 (dividend tensor must not be a complex-valued type)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
