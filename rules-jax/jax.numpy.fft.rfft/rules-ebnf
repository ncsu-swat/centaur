Rule 1 (dimension of input tensor must be at least 1)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (axis must be within the valid range of dimensions of input tensor)
{v_1 : tensor, v_3 : int} |= v_3 ≥ 0 - ndim(v_1) ∧ v_3 < ndim(v_1)
>>
Rule 3 (the size of the transform must be a positive integer)
{v_2 : int} |= v_2 > 0
>>
Rule 4 (the size of the input along the specified axis must be greater than zero)
{v_1 : tensor, v_3 : int} |= if v_3 ≥ 0 then shape(v_1, v_3) > 0 else shape(v_1, ndim(v_1) + v_3) > 0
>>
Rule 9 (all dimensions of the input tensor must have size greater than zero)
{v_1 : tensor} |= ndim(v_1) ≥ 1 ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0)
>>
Rule 10 (the transform length must be positive and the input tensor must be at least 1-dimensional)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 1 ∧ v_2 ≥ 1
>>
Rule 11 (the axis must be valid and the corresponding dimension size must be positive)
{v_1 : tensor, v_3 : int} |= if v_3 ≥ 0 then v_3 < ndim(v_1) ∧ shape(v_1, v_3) > 0 else v_3 ≥ 0 - ndim(v_1) ∧ shape(v_1, ndim(v_1) + v_3) > 0
>>
Rule 12 (if the input tensor is 1-dimensional, the axis must be 0 or -1)
{v_1 : tensor, v_3 : int} |= if ndim(v_1) = 1 then v_3 = 0 ∨ v_3 = 0 - 1
>>
Rule 14 (axis must be within the valid range of input tensor dimensions)
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 - ndim(v_1) ∧ v_2 < ndim(v_1)
>>
Rule 15 (n, the length of the Fourier transform, must be a positive integer)
{v_1 : int} |= v_1 > 0
>>
Rule 16 (input tensor must be real-valued)
{v_1 : tensor} |= dtype_(v_1) ≤ 8
>>
Rule 17 (dimension of input tensor must not be 0)
{v_1 : tensor} |= ndim(v_1) ≠ 0
>>
Rule 19 (axis along which to compute the FFT must be a valid dimension of the input tensor)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then 0 - ndim(v_1) ≤ v_2 else v_2 < ndim(v_1)
>>
Rule 20 (effective dimension size n must be positive)
{v_1 : int} |= v_1 ≥ 1
