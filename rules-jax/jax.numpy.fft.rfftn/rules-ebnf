Rule 1 (input tensor should have a real-valued data type, not complex)
{v_1 : tensor} |= dtype_(v_1) ≤ 8
>>
Rule 2 (input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 3 (axes list length must be less than or equal to input tensor dimensions)
{v_1 : tensor, v_2 : list(int)} |= v_2.len ≤ ndim(v_1)
>>
Rule 4 (axes tuple length must be less than or equal to input tensor dimensions)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≤ ndim(v_1)
>>
Rule 5 (sizes specified in list s must be positive)
{v_1 : list(int)} |= ∀ i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 6 (sizes specified in tuple s must be positive)
{v_1 : tuple(int)} |= ∀ i ∈ [0, v_1.len - 1] : v_1[i] > 0
