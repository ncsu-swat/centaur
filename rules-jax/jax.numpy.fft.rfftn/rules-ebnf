Rule 9 (axes specified in list must be unique)
{v_1 : list(int)} |= ∀ i ∈ [0, v_1.len - 1] : (∀ j ∈ [0, v_1.len - 1] : (if i ≠ j then v_1[i] ≠ v_1[j]))
