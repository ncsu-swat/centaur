Rule 10 (axes specified in tuple must be unique)
{v_1 : tuple(int)} |= ∀ i ∈ [0, v_1.len - 1] : (∀ j ∈ [0, v_1.len - 1] : (if i ≠ j then v_1[i] ≠ v_1[j]))
>>
Rule 17 (axes specified in list must be within valid range)
{v_1 : tensor, v_2 : list(int)} |= ∀ i ∈ [0, v_2.len - 1] : (v_2[i] ≥ 0 - ndim(v_1) ∧ v_2[i] < ndim(v_1))
