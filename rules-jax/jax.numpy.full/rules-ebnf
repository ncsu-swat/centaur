Rule 1 (Shape as an integer must be non-negative)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 2 (All elements in the shape tuple must be non-negative)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 3 (All elements in the shape list must be non-negative)
{v_1 : list(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 4 (The rank of the fill_value tensor must not exceed the length of the shape tuple)
{v_1 : tuple(int), v_2 : tensor} |= ndim(v_2) ≤ v_1.len
>>
Rule 6 (The dtype of the filled array must not be string)
{v_1 : dtype} |= v_1 ≠ 11
>>
Rule 10 (the fill_value tensor must be broadcast-compatible with a 1D target shape)
{v_1 : int, v_2 : tensor} |= ndim(v_2) = 0 ∨ (ndim(v_2) = 1 ∧ (shape(v_2, 0) = v_1 ∨ shape(v_2, 0) = 1))
>>
Rule 11 (the fill_value tensor must be broadcast-compatible with the target shape tuple)
{v_1 : tuple(int), v_2 : tensor} |= ndim(v_2) ≤ v_1.len ∧ (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, ndim(v_2) - 1 - i) = v_1[v_1.len - 1 - i] ∨ shape(v_2, ndim(v_2) - 1 - i) = 1)
>>
Rule 13 (shape must be non-negative and dtype must not be string)
{v_1 : int, v_2 : dtype} |= v_1 ≥ 0 ∧ v_2 ≠ 11
>>
Rule 14 (all elements in the shape tuple must be non-negative and dtype must not be string)
{v_1 : tuple(int), v_2 : dtype} |= v_2 ≠ 11 ∧ (∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0)
>>
Rule 15 (all elements in the shape list must be non-negative and dtype must not be string)
{v_1 : list(int), v_2 : dtype} |= v_2 ≠ 11 ∧ (∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0)
>>
Rule 18 (neither the fill_value tensor's dtype nor the target dtype can be string)
{v_1 : tensor, v_2 : dtype} |= dtype_(v_1) ≠ 11 ∧ v_2 ≠ 11
