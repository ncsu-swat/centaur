>>
Rule 1 (first input tensor must have an integer data type)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5
>>
Rule 2 (second input tensor must have an integer data type)
{v_2 : tensor} |= 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5
>>
Rule 3 (same-dimensional input tensors must have broadcast-compatible shapes)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 4 (input tensors must have positive shape dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 5 (both input tensors must have integer data types)
{v_1 : tensor, v_2 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 ∧ 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5
>>
Rule 6 (broadcasting compatibility for tensors of the same dimension)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then (∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i)) ∨ (shape(v_1, i) = 1) ∨ (shape(v_2, i) = 1))
>>
Rule 7 (both input tensors must not have empty dimensions)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0)
>>
Rule 8 (integer inputs should be within the standard 32-bit signed integer range)
{v_1 : int, v_2 : int} |= (v_1 ≥ -2147483648 ∧ v_1 ≤ 2147483647) ∧ (v_2 ≥ -2147483648 ∧ v_2 ≤ 2147483647)
>>
Rule 9 (dimension compatibility for 1D and 2D tensor inputs)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 1) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 1) = 1
>>
Rule 10 (integer inputs should not both be zero)
{v_1 : int, v_2 : int} |= v_1 ≠ 0 ∨ v_2 ≠ 0
>>
Rule 11 (inputs of union type int or float must be mathematical integers)
{v_1 : int ⊎ float, v_2 : int ⊎ float} |= v_1 % 1 = 0 ∧ v_2 % 1 = 0
>>
Rule 12 (first dimension of 3D tensors must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 3 ∧ ndim(v_2) = 3 then shape(v_1, 0) = shape(v_2, 0)
