>>
Rule 1 (broadcasting compatibility for input tensors)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1
>>
Rule 2 (input tensors must have comparable non-complex dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 8 ∧ dtype_(v_2) ≤ 8
>>
Rule 5 (input tensors must have identical shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 6 (trailing dimensions must be broadcast-compatible when first tensor has rank greater than or equal to second tensor)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ ndim(v_2) ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1
>>
Rule 7 (broadcasting compatibility for tensors of identical rank)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 8 (broadcasting compatibility when the first tensor has rank greater than or equal to the second tensor)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ ndim(v_2) ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 1 ∨ shape(v_1, ndim(v_1) - ndim(v_2) + i) = 1 ∨ shape(v_1, ndim(v_1) - ndim(v_2) + i) = shape(v_2, i)
>>
Rule 9 (broadcasting compatibility when the second tensor has rank greater than the first tensor)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) > ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1 ∨ shape(v_2, ndim(v_2) - ndim(v_1) + i) = 1 ∨ shape(v_2, ndim(v_2) - ndim(v_1) + i) = shape(v_1, i)
