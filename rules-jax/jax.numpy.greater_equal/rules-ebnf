Rule 1 (broadcast compatibility of input tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ ndim(v_2) then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = shape(v_1, ndim(v_1) - ndim(v_2) + i) ∨ shape(v_2, i) = 1 ∨ shape(v_1, ndim(v_1) - ndim(v_2) + i) = 1 else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, ndim(v_2) - ndim(v_1) + i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, ndim(v_2) - ndim(v_1) + i) = 1
>>
Rule 2 (non-complex data types for element-wise comparison)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 8 ∧ dtype_(v_2) ≤ 8
>>
Rule 3 (all dimensions of input tensors must be positive)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (if ndim(v_2) > 0 then ∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 4 (broadcast compatibility for tensors of the same rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 5 (broadcast compatibility for tensors of unequal rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) ∧ ndim(v_2) > 0 then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = shape(v_1, ndim(v_1) - ndim(v_2) + i) ∨ shape(v_2, i) = 1 ∨ shape(v_1, ndim(v_1) - ndim(v_2) + i) = 1
>>
Rule 7 (dimension compatibility for 1D and multi-dimensional tensor comparisons)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) > 1 ∧ ndim(v_2) = 1 then shape(v_2, 0) = 1 ∨ shape(v_2, 0) = shape(v_1, ndim(v_1) - 1)) ∧ (if ndim(v_2) > 1 ∧ ndim(v_1) = 1 then shape(v_1, 0) = 1 ∨ shape(v_1, 0) = shape(v_2, ndim(v_2) - 1))
>>
Rule 8 (dimension compatibility for tensors of the same rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 9 (tensors must have comparable numeric or boolean data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) < 9 ∧ dtype_(v_2) < 9
>>
Rule 11 (dimension compatibility for rank difference of one)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) - ndim(v_2) = 1 ∧ ndim(v_2) > 0 then (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = shape(v_1, i + 1) ∨ shape(v_2, i) = 1 ∨ shape(v_1, i + 1) = 1) else if ndim(v_2) - ndim(v_1) = 1 ∧ ndim(v_1) > 0 then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i + 1) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i + 1) = 1)
