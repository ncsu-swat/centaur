Rule 1 (broadcast compatibility for tensors of the same rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 2 (input tensors must have non-complex numeric or boolean data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 8 ∧ dtype_(v_2) ≤ 8
>>
Rule 4 (general broadcast compatibility along trailing dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ ndim(v_2) then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1 else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1
>>
Rule 6 (broadcast compatibility for trailing dimension when the second tensor is 1D)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 1 ∧ ndim(v_2) = 1 then shape(v_1, ndim(v_1) - 1) = shape(v_2, 0) ∨ shape(v_2, 0) = 1 ∨ shape(v_1, ndim(v_1) - 1) = 1
>>
Rule 7 (first dimension broadcast compatibility for tensors of the same non-zero rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) > 0 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 8 (tensors must not have complex data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 9 (broadcast compatibility for 1D vectors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 10 (broadcast compatibility when comparing a 2D matrix with a 1D vector)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 1 then shape(v_1, 1) = shape(v_2, 0) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 11 (broadcast compatibility when comparing a 1D vector with a 2D matrix)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 1) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 1) = 1
>>
Rule 12 (broadcast compatibility for trailing dimension of non-scalar tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 13 (broadcast compatibility for penultimate dimension of tensors with rank at least 2)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 then shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2) ∨ shape(v_1, ndim(v_1) - 2) = 1 ∨ shape(v_2, ndim(v_2) - 2) = 1
>>
Rule 14 (broadcasting trailing dimensions when first tensor has strictly higher rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) ∧ ndim(v_2) > 0 then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, ndim(v_1) - ndim(v_2) + i) = shape(v_2, i) ∨ shape(v_1, ndim(v_1) - ndim(v_2) + i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 15 (broadcasting trailing dimensions when second tensor has strictly higher rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > ndim(v_1) ∧ ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, ndim(v_2) - ndim(v_1) + i) = shape(v_1, i) ∨ shape(v_2, ndim(v_2) - ndim(v_1) + i) = 1 ∨ shape(v_1, i) = 1
