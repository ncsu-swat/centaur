>>
Rule 1 (input x1 tensor cannot have complex dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 2 (input x2 tensor cannot have complex dtype)
{v_2 : tensor} |= dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 3 (broadcast compatibility of x1 and x2 shapes when they have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 4 (all shape dimensions of x1 tensor must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 5 (all shape dimensions of x2 tensor must be positive)
{v_2 : tensor} |= ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 10 (shape dimensions must be positive for both input tensors)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 12 (both input tensors must have non-complex dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 8 ∧ dtype_(v_2) ≤ 8
>>
Rule 14 (1-dimensional tensor broadcasting compatibility)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 15 (2-dimensional tensor broadcasting compatibility)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1) ∧ (shape(v_1, 1) = shape(v_2, 1) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 1) = 1)
>>
Rule 16 (non-complex dtype for x2 when x1 is float)
{v_1 : float, v_2 : tensor} |= if v_1 > 0.0 ∨ v_1 ≤ 0.0 then dtype_(v_2) ≤ 8 else false
>>
Rule 17 (non-complex dtype for x1 when x2 is float)
{v_1 : tensor, v_2 : float} |= if v_2 > 0.0 ∨ v_2 ≤ 0.0 then dtype_(v_1) ≤ 8 else false
>>
Rule 18 (non-complex dtype for x2 when x1 is integer)
{v_1 : int, v_2 : tensor} |= if v_1 > 0 ∨ v_1 ≤ 0 then dtype_(v_2) ≤ 8 else false
