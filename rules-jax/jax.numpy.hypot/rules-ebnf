Rule 1 (Tensor arguments must not have complex dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 2 (Tensor dimension compatibility for broadcasting when they have the same rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 3 (Tensor shape dimensions must be greater than zero)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 8 (The first input tensor must not have a complex dtype)
{v_1 : tensor} |= dtype_(v_1) ≤ 8
>>
Rule 9 (The second input tensor must not have a complex dtype)
{v_2 : tensor} |= dtype_(v_2) ≤ 8
>>
Rule 10 (The trailing dimension of both tensors must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 11 (The second-to-last dimension of both tensors must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 1 ∧ ndim(v_2) > 1 then shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2) ∨ shape(v_1, ndim(v_1) - 2) = 1 ∨ shape(v_2, ndim(v_2) - 2) = 1
