>>
Rule 1 (input tensor must be one-dimensional)
{v_1 : tensor} |= ndim(v_1) = 1
>>
Rule 2 (input sequence should be 1-D with boolean or integer dtype)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5
>>
Rule 3 (all input sequences must be one-dimensional)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1
>>
Rule 4 (1D sequence for open mesh construction is either empty or contains non-negative index values)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ (shape(v_1, 0) = 0 ∨ min(v_1) ≥ 0)
>>
Rule 5 (input sequences must be 1-dimensional and have the same data type)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ dtype_(v_1) = dtype_(v_2)
>>
Rule 6 (three input sequences for a 3D grid must all be one-dimensional)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ ndim(v_3) = 1
>>
Rule 7 (both input sequences must be non-empty 1-dimensional tensors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ shape(v_1, 0) > 0 ∧ shape(v_2, 0) > 0
>>
Rule 8 (integer index sequences must contain non-negative values)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then shape(v_1, 0) = 0 ∨ min(v_1) ≥ 0
>>
Rule 9 (boolean sequence used for open mesh indexing must be 1-dimensional)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ dtype_(v_1) = 0
>>
Rule 10 (input sequence must be a 1-dimensional integer array)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5
>>
Rule 11 (input sequence can be a 1-dimensional floating-point array)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 12 (1-dimensional sequence must have positive length)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
