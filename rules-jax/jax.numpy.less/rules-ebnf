>>
Rule 1 (broadcast compatibility for tensor inputs)
{v_1 : tensor, v_2 : tensor} |= ∀ i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1
>>
Rule 2 (input tensor must have a boolean, integer, or floating-point data type)
{v_1 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 3 (both tensor inputs must have comparable numeric or boolean data types)
{v_1 : tensor, v_2 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 ∧ 0 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 6 (equal-rank tensors must have compatible dimensions along each axis)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 10 (data types of the two input tensors should match)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 12 (inputs with same shape must have identical dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 13 (1D tensors must have identical length or at least one must be of size 1 for broadcasting)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 14 (trailing dimensions of both tensors must be broadcast compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 15 (input tensor must not have a complex data type)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 16 (neither tensor input may have string or complex data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) < 9 ∧ dtype_(v_2) < 9
>>
Rule 17 (leading dimensions must be broadcast compatible when tensors have the same rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) > 0 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 18 (2D tensors must be broadcast compatible across both spatial dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1) ∧ (shape(v_1, 1) = shape(v_2, 1) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 1) = 1)
>>
Rule 19 (broadcast compatibility between a 2D tensor and a 1D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 1 then shape(v_1, 1) = shape(v_2, 0) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 20 (broadcast compatibility between a higher-dimensional tensor and a 1D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 1 ∧ ndim(v_2) = 1 then shape(v_1, ndim(v_1) - 1) = shape(v_2, 0) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 21 (all dimensions of a non-empty tensor must be strictly positive)
{v_1 : tensor} |= ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 22 (tensor data type must not be complex or string)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_1) ≠ 11
>>
Rule 23 (trailing dimension compatibility for multi-dimensional tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 24 (3D tensors must be broadcast compatible across all corresponding axes)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 3 ∧ ndim(v_2) = 3 then (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1) ∧ (shape(v_1, 1) = shape(v_2, 1) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 1) = 1) ∧ (shape(v_1, 2) = shape(v_2, 2) ∨ shape(v_1, 2) = 1 ∨ shape(v_2, 2) = 1)
>>
Rule 25 (broadcast compatibility between a 3D tensor and a 1D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 3 ∧ ndim(v_2) = 1 then shape(v_1, 2) = shape(v_2, 0) ∨ shape(v_1, 2) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 26 (broadcast compatibility between a 3D tensor and a 2D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 3 ∧ ndim(v_2) = 2 then (shape(v_1, 1) = shape(v_2, 0) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 0) = 1) ∧ (shape(v_1, 2) = shape(v_2, 1) ∨ shape(v_1, 2) = 1 ∨ shape(v_2, 1) = 1)
>>
Rule 27 (the minimum value of a tensor must not exceed its maximum value)
{v_1 : tensor} |= min(v_1) ≤ max(v_1)
>>
Rule 28 (broadcast compatibility between two 4D tensors across all axes)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 4 ∧ ndim(v_2) = 4 then (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1) ∧ (shape(v_1, 1) = shape(v_2, 1) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 1) = 1) ∧ (shape(v_1, 2) = shape(v_2, 2) ∨ shape(v_1, 2) = 1 ∨ shape(v_2, 2) = 1) ∧ (shape(v_1, 3) = shape(v_2, 3) ∨ shape(v_1, 3) = 1 ∨ shape(v_2, 3) = 1)
>>
Rule 29 (penultimate dimension compatibility for tensors with rank at least 2)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 then shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2) ∨ shape(v_1, ndim(v_1) - 2) = 1 ∨ shape(v_2, ndim(v_2) - 2) = 1
>>
Rule 30 (2D tensor must have positive dimensions along both axes)
{v_1 : tensor} |= ndim(v_1) = 2 ∧ shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 31 (broadcast compatibility between a 1D tensor and a 2D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 1) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 1) = 1
>>
Rule 32 (broadcast compatibility between a 1D tensor and a 3D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 3 then shape(v_1, 0) = shape(v_2, 2) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 2) = 1
>>
Rule 33 (broadcast compatibility between a 2D tensor and a 3D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 3 then (shape(v_1, 0) = shape(v_2, 1) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 1) = 1) ∧ (shape(v_1, 1) = shape(v_2, 2) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 2) = 1)
>>
Rule 34 (compatibility of the third dimension from the end for rank 3 or higher tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 3 ∧ ndim(v_2) ≥ 3 then shape(v_1, ndim(v_1) - 3) = shape(v_2, ndim(v_2) - 3) ∨ shape(v_1, ndim(v_1) - 3) = 1 ∨ shape(v_2, ndim(v_2) - 3) = 1
>>
Rule 35 (broadcast compatibility holds trivially if either tensor is a 0D scalar tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∨ ndim(v_2) = 0 then true else shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 36 (tensor rank must be within standard dimensional limits)
{v_1 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_1) ≤ 8
>>
Rule 37 (broadcast compatibility between a 1D tensor and a 4D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 4 then shape(v_1, 0) = shape(v_2, 3) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 3) = 1
>>
Rule 38 (broadcast compatibility between a 2D tensor and a 4D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 4 then (shape(v_1, 0) = shape(v_2, 2) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 2) = 1) ∧ (shape(v_1, 1) = shape(v_2, 3) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 3) = 1)
>>
Rule 39 (broadcast compatibility between a 3D tensor and a 4D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 3 ∧ ndim(v_2) = 4 then (shape(v_1, 0) = shape(v_2, 1) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 1) = 1) ∧ (shape(v_1, 1) = shape(v_2, 2) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 2) = 1) ∧ (shape(v_1, 2) = shape(v_2, 3) ∨ shape(v_1, 2) = 1 ∨ shape(v_2, 3) = 1)
>>
Rule 40 (compatibility of the fourth dimension from the end for rank 4 or higher tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 4 ∧ ndim(v_2) ≥ 4 then shape(v_1, ndim(v_1) - 4) = shape(v_2, ndim(v_2) - 4) ∨ shape(v_1, ndim(v_1) - 4) = 1 ∨ shape(v_2, ndim(v_2) - 4) = 1
>>
Rule 41 (all dimension sizes of an input tensor must be non-negative)
{v_1 : tensor} |= ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 42 (tensor data type cannot be a dtype object)
{v_1 : tensor} |= dtype_(v_1) ≠ 12
