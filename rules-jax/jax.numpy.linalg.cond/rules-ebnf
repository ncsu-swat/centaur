Rule 1 (input tensor must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (input matrix must be square if p is an integer other than 2 or -2)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 2 ∧ (v_2 = 2 ∨ v_2 = -2 ∨ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2))
>>
Rule 3 (input matrix must be square if p is a float other than 2.0 or -2.0)
{v_1 : tensor, v_2 : float} |= ndim(v_1) ≥ 2 ∧ (v_2 = 2 ∨ v_2 = -2 ∨ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2))
>>
Rule 5 (all dimensions of the input tensor must be positive)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0)
>>
Rule 9 (input matrix must be square if p is a string other than "none")
{v_1 : tensor, v_2 : str} |= ndim(v_1) ≥ 2 ∧ (v_2 = "none" ∨ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2))
>>
Rule 11 (input tensor should have float or complex data type)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 10
>>
Rule 12 (input matrix must be square if integer p is not 2 or -2)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 2 ∧ (v_2 = 1 ∨ v_2 = -1 ∨ v_2 = 2 ∨ v_2 = -2) ∧ (if v_2 = 1 ∨ v_2 = -1 then shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2))
>>
Rule 13 (input matrix must be square if float p is not 2.0 or -2.0)
{v_1 : tensor, v_2 : float} |= ndim(v_1) ≥ 2 ∧ (if v_2 ≠ 2 ∧ v_2 ≠ -2 then shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2))
>>
Rule 14 (input matrix must be square if string p is not "none")
{v_1 : tensor, v_2 : str} |= ndim(v_1) ≥ 2 ∧ (if v_2 ≠ "none" then shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2))
>>
Rule 15 (all dimensions of the input tensor must be positive)
{v_1 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 1) ∧ ndim(v_1) ≥ 2
