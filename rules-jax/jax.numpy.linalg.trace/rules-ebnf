>>
Rule 1 (input tensor must be at least 2-dimensional)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (offset must be within the bounds of the matrix dimensions to ensure a non-empty diagonal)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 2 ∧ 0 - shape(v_1, ndim(v_1) - 2) < v_2 ∧ v_2 < shape(v_1, ndim(v_1) - 1)
>>
Rule 3 (input tensor must have a numeric data type)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 4 (The input tensor x must have at least 2 dimensions, and all dimensions must be positive)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 5 (The offset must not exceed the matrix dimensions in either positive or negative direction)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 2 ∧ (if v_2 > 0 then v_2 < shape(v_1, ndim(v_1) - 1) else (if v_2 < 0 then 0 - v_2 < shape(v_1, ndim(v_1) - 2)))
>>
Rule 6 (The input tensor x must not be a string/object type)
{v_1 : tensor} |= dtype_(v_1) < 11
>>
Rule 7 (The innermost two dimensions of x must be equal for a square matrix trace)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 8 (For a square matrix, the absolute offset must be less than the matrix dimension size)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2) then (if v_2 ≥ 0 then v_2 < shape(v_1, ndim(v_1) - 1) else 0 - v_2 < shape(v_1, ndim(v_1) - 1))
>>
Rule 9 (Negative offset must be within the row dimension of the input tensor)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 2 ∧ (if v_2 < 0 then 0 - v_2 < shape(v_1, ndim(v_1) - 2))
