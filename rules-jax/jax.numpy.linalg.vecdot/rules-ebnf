>>
Rule 1 (both tensors must have at least 1 dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 2 (axis must be within the valid range for the first tensor)
{v_1 : tensor, v_3 : int} |= (v_3 ≥ 0 ∧ v_3 < ndim(v_1)) ∨ (v_3 < 0 ∧ v_3 ≥ 0 - ndim(v_1))
>>
Rule 3 (axis must be within the valid range for the second tensor)
{v_2 : tensor, v_3 : int} |= (v_3 ≥ 0 ∧ v_3 < ndim(v_2)) ∨ (v_3 < 0 ∧ v_3 ≥ 0 - ndim(v_2))
>>
Rule 4 (size of the contracting dimension must match for both tensors)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= (v_3 ≥ 0 ∧ shape(v_1, v_3) = shape(v_2, v_3)) ∨ (v_3 < 0 ∧ shape(v_1, ndim(v_1) + v_3) = shape(v_2, ndim(v_2) + v_3))
>>
Rule 5 (broadcasting compatibility for non-contracting dimensions when number of dimensions matches)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 1] : (i = v_3 ∨ i = ndim(v_1) + v_3 ∨ shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1))
>>
Rule 6 (precision string must be 'highest' or 'none')
{v_4 : str} |= v_4 = "highest" ∨ v_4 = "none"
>>
Rule 7 (precision tuple length and elements must be valid)
{v_4 : tuple(str)} |= v_4.len = 2 ∧ (v_4[0] = "highest" ∨ v_4[0] = "none") ∧ (v_4[1] = "highest" ∨ v_4[1] = "none")
>>
Rule 8 (preferred_element_type must be a float or complex datatype)
{v_5 : dtype} |= 6 ≤ v_5 ∧ v_5 ≤ 10
>>
Rule 9 (input tensors must have numeric dtypes)
{v_1 : tensor, v_2 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 ∧ 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10
