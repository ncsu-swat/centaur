{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 0 ∨ ndim(v_2) = 0 ∨ ∀i ∈ [1, if ndim(v_1) < ndim(v_2) then ndim(v_1) else ndim(v_2)] : shape(v_1, ndim(v_1) - i) = shape(v_2, ndim(v_2) - i) ∨ shape(v_1, ndim(v_1) - i) = 1 ∨ shape(v_2, ndim(v_2) - i) = 1
