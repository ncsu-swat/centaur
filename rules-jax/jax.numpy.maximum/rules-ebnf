Rule 2 (input tensors must have matching data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (inputs must have supported numeric or boolean data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≥ 0 ∧ dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≥ 0 ∧ dtype_(v_2) ≤ 10
>>
Rule 4 (if first tensor is 2D and second tensor is 1D, trailing dimension must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 1 then shape(v_1, 1) = shape(v_2, 0) ∨ shape(v_2, 0) = 1 ∨ shape(v_1, 1) = 1
>>
Rule 7 (trailing dimensions must be broadcast-compatible when both inputs are at least 1D)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 9 (both input tensors have floating-point data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 8 ∧ dtype_(v_2) ≥ 6 ∧ dtype_(v_2) ≤ 8
>>
Rule 10 (both input tensors have integer data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5 ∧ dtype_(v_2) ≥ 1 ∧ dtype_(v_2) ≤ 5
>>
Rule 11 (leading dimensions must be broadcast-compatible when both inputs are 2D tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 12 (1D tensor must be broadcast-compatible with the trailing dimension of a 2D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 1) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 1) = 1
>>
Rule 13 (second dimension must be broadcast-compatible when both inputs are 2D tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 1) = shape(v_2, 1) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 1) = 1
>>
Rule 14 (1D tensor must be broadcast-compatible with the trailing dimension of a 3D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 3 ∧ ndim(v_2) = 1 then shape(v_1, 2) = shape(v_2, 0) ∨ shape(v_1, 2) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 15 (both input tensors have boolean data type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = 0 ∧ dtype_(v_2) = 0
>>
Rule 16 (both input tensors have complex floating-point data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≥ 9 ∧ dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≥ 9 ∧ dtype_(v_2) ≤ 10
>>
Rule 17 (first dimension must be broadcast-compatible when both inputs are 3D tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 3 ∧ ndim(v_2) = 3 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
