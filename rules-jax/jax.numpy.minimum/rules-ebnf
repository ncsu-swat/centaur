Rule 1 (broadcast compatibility for element-wise minimum)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≤ ndim(v_2) then (∀ i ∈ [1, ndim(v_1)] : shape(v_1, ndim(v_1) - i) = shape(v_2, ndim(v_2) - i) ∨ shape(v_1, ndim(v_1) - i) = 1 ∨ shape(v_2, ndim(v_2) - i) = 1) else (∀ i ∈ [1, ndim(v_2)] : shape(v_1, ndim(v_1) - i) = shape(v_2, ndim(v_2) - i) ∨ shape(v_1, ndim(v_1) - i) = 1 ∨ shape(v_2, ndim(v_2) - i) = 1)
>>
Rule 3 (last dimension compatibility for broadcasting)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 4 (second-to-last dimension compatibility for broadcasting)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 then shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2) ∨ shape(v_1, ndim(v_1) - 2) = 1 ∨ shape(v_2, ndim(v_2) - 2) = 1
>>
Rule 5 (broadcast compatibility when first tensor has higher rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) then (∀i ∈ [1, ndim(v_2)] : shape(v_1, ndim(v_1) - i) = shape(v_2, ndim(v_2) - i) ∨ shape(v_1, ndim(v_1) - i) = 1 ∨ shape(v_2, ndim(v_2) - i) = 1)
>>
Rule 6 (broadcast compatibility when second tensor has higher rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > ndim(v_1) then (∀i ∈ [1, ndim(v_1)] : shape(v_1, ndim(v_1) - i) = shape(v_2, ndim(v_2) - i) ∨ shape(v_1, ndim(v_1) - i) = 1 ∨ shape(v_2, ndim(v_2) - i) = 1)
>>
Rule 7 (broadcast compatibility when both tensors have equal rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 8 (input tensor data types must be numeric or boolean)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≤ 10
>>
Rule 9 (broadcast compatibility when first tensor is 1D)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) ≥ 1 then shape(v_1, 0) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 10 (broadcast compatibility when second tensor is 1D)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 1 ∧ ndim(v_1) ≥ 1 then shape(v_2, 0) = shape(v_1, ndim(v_1) - 1) ∨ shape(v_2, 0) = 1 ∨ shape(v_1, ndim(v_1) - 1) = 1
>>
Rule 11 (broadcast compatibility between 2D and 3D tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 3 then (shape(v_1, 1) = shape(v_2, 2) ∨ shape(v_1, 1) = 1 ∨ shape(v_2, 2) = 1) ∧ (shape(v_1, 0) = shape(v_2, 1) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 1) = 1)
