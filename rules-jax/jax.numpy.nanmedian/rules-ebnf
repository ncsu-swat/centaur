Rule 5 (input tensor must be of a supported non-complex numeric type)
{v_1 : tensor} |= dtype_(v_1) ≤ 8
>>
Rule 6 (The dimension of the input tensor along the specified integer axis must be positive)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then shape(v_1, ndim(v_1) + v_2) > 0 else shape(v_1, v_2) > 0
>>
Rule 7 (The dimension of the input tensor along all specified tuple axes must be positive)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : if v_2[i] < 0 then shape(v_1, ndim(v_1) + v_2[i]) > 0 else shape(v_1, v_2[i]) > 0
