    >>> x = jnp.array([1, 2, jnp.nan, 4, 5])
    >>> weights = jnp.array([1, 1, 1, 2, 1])
    >>> jnp.nanpercentile(x, 50, weights=weights, method='inverted_cdf')
    Array(4.0, dtype=float32)

