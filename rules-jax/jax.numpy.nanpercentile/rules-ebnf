Rule 2 (integer axis range)
{v_1 : tensor, v_3 : int} |= v_3 ≥ 0 - ndim(v_1) ∧ v_3 < ndim(v_1)
>>
Rule 3 (tuple axis range)
{v_1 : tensor, v_3 : tuple(int)} |= ∀ i ∈ [0, v_3.len - 1] : (v_3[i] ≥ 0 - ndim(v_1) ∧ v_3[i] < ndim(v_1))
>>
Rule 4 (unsupported overwrite_input option)
{v_4 : bool} |= v_4 = false
>>
Rule 5 (weights array shape compatibility)
{v_1 : tensor, v_3 : int, v_7 : tensor} |= ndim(v_7) = 1 ∧ (if v_3 ≥ 0 then shape(v_7, 0) = shape(v_1, v_3) else shape(v_7, 0) = shape(v_1, ndim(v_1) + v_3))
>>
Rule 6 (numerical data type of the input array)
{v_1 : tensor} |= dtype_(v_1) ≤ 10
>>
Rule 7 (quantile tensor dimension limit)
{v_2 : tensor} |= ndim(v_2) ≤ 1
>>
Rule 8 (quantile tensor values range)
{v_2 : tensor} |= min(v_2) ≥ 0 ∧ max(v_2) ≤ 100
>>
Rule 9 (valid reduction axis index)
{v_1 : tensor, v_3 : int} |= 0 - ndim(v_1) ≤ v_3 ∧ v_3 < ndim(v_1)
>>
Rule 10 (valid reduction axes in tuple)
{v_1 : tensor, v_3 : tuple(int)} |= ∀i ∈ [0, v_3.len - 1] : 0 - ndim(v_1) ≤ v_3[i] ∧ v_3[i] < ndim(v_1)
>>
Rule 15 (non-empty quantile tensor when 1-dimensional)
{v_2 : tensor} |= if ndim(v_2) = 1 then shape(v_2, 0) > 0
>>
Rule 16 (quantile tensor must have integer or floating-point data type)
{v_2 : tensor} |= 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 18 (valid reduction axes in tuple)
{v_1 : tensor, v_3 : tuple(int)} |= v_3.len ≤ ndim(v_1) ∧ ∀i ∈ [0, v_3.len - 1] : 0 - ndim(v_1) ≤ v_3[i] ∧ v_3[i] < ndim(v_1)
>>
Rule 19 (weights size must match target reduction dimension size)
{v_1 : tensor, v_3 : int, v_7 : tensor} |= if v_3 ≥ 0 ∧ v_3 < ndim(v_1) ∧ ndim(v_7) = 1 then shape(v_7, 0) = shape(v_1, v_3)
