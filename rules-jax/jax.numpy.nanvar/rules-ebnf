Rule 4 (where tensor must have a boolean dtype)
{v_1 : tensor} |= dtype_(v_1) = 0
>>
Rule 5 (mean tensor must have a floating-point or complex dtype)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 7 (axis as int must be within valid dimensions of tensor a)
{v_1 : tensor, v_2 : int} |= 0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 8 (axis as tuple must have elements within valid dimensions of tensor a)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 9 (axis as list must have elements within valid dimensions of tensor a)
{v_1 : tensor, v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 12 (if axis is an integer, ddof must be less than the size of the tensor along that axis)
{v_1 : tensor, v_2 : int, v_3 : int} |= if v_2 ≥ 0 ∧ v_2 < ndim(v_1) then v_3 < shape(v_1, v_2) else if v_2 < 0 ∧ v_2 ≥ 0 - ndim(v_1) then v_3 < shape(v_1, ndim(v_1) + v_2)
>>
Rule 15 (if keepdims is true, mean must have the same number of dimensions as a)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 then ndim(v_1) = ndim(v_2)
>>
Rule 16 (if where has the same number of dimensions as a, their shapes must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 19 (if keepdims is false and axis is a valid positive integer, mean must have one less dimension than a)
{v_1 : tensor, v_2 : tensor, v_3 : int, v_4 : bool} |= if v_4 = false ∧ ndim(v_1) ≥ 1 ∧ v_3 ≥ 0 ∧ v_3 < ndim(v_1) then ndim(v_2) = ndim(v_1) - 1
>>
Rule 20 (if where has the same number of dimensions as a, their shapes must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 0 ∧ ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
