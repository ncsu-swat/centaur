Rule 1 (Broadcasting compatibility of dimensions for tensor inputs)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 2 (Equal dimension compatibility for tensor inputs)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 6 (Tensor inputs should not have string dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_2) ≠ 11
>>
Rule 9 (Tensor should not be empty)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 10 (Input tensor should not have string dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 11
>>
Rule 11 (For two tensor inputs: if they have different number of dimensions, at least one must be 1D)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≠ ndim(v_2) then ndim(v_1) = 1 ∨ ndim(v_2) = 1
>>
Rule 12 (For tensor and float inputs: if the float is zero, the tensor cannot be empty)
{v_1 : tensor, v_2 : float} |= if v_2 = 0 then ndim(v_1) > 0
>>
Rule 13 (For tensor and integer inputs: if the integer is negative, the tensor dtype cannot be boolean)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then dtype_(v_1) ≠ 0
>>
Rule 14 (For tensor and boolean inputs: if the boolean is true, the tensor dtype must be boolean)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then dtype_(v_1) = 0
>>
Rule 15 (For two 1-dimensional tensors: they must have the same length)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 17 (For tensor and float inputs: if the float is negative, the tensor cannot have a boolean dtype)
{v_1 : tensor, v_2 : float} |= if v_2 < 0 then dtype_(v_1) ≠ 0
>>
Rule 19 (For tensor and boolean inputs: if the boolean is true, the tensor cannot have string dtype)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then dtype_(v_1) ≠ 11
