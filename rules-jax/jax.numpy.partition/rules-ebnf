>>
Rule 1 (dimension of the input tensor must be at least 1)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (axis must be a valid dimension index of the input tensor)
{v_1 : tensor, v_3 : int} |= v_3 ≥ 0 - ndim(v_1) ∧ v_3 < ndim(v_1)
>>
Rule 3 (partition axis size must be greater than zero)
{v_1 : tensor, v_3 : int} |= (v_3 ≥ 0 - ndim(v_1) ∧ v_3 < ndim(v_1)) ∧ (if v_3 < 0 then shape(v_1, v_3 + ndim(v_1)) > 0 else shape(v_1, v_3) > 0)
>>
Rule 4 (kth index must be within the bounds of the partition axis size)
{v_1 : tensor, v_2 : int, v_3 : int} |= (v_3 ≥ 0 - ndim(v_1) ∧ v_3 < ndim(v_1)) ∧ (if v_3 < 0 then v_2 ≥ 0 - shape(v_1, v_3 + ndim(v_1)) ∧ v_2 < shape(v_1, v_3 + ndim(v_1)) else v_2 ≥ 0 - shape(v_1, v_3) ∧ v_2 < shape(v_1, v_3))
>>
Rule 5 (input tensor must have a valid numeric or boolean dtype)
{v_1 : tensor} |= dtype_(v_1) ≤ 10
>>
Rule 7 (if the input tensor is 1-dimensional, axis must be 0 or -1)
{v_1 : tensor, v_3 : int} |= (if ndim(v_1) = 1 then v_3 = 0 ∨ v_3 = 0 - 1 else v_3 ≥ 0 - ndim(v_1) ∧ v_3 < ndim(v_1))
>>
Rule 8 (kth as a list of integers must have elements within the partition axis bounds)
{v_1 : tensor, v_2 : list(int), v_3 : int} |= v_2.len > 0 ∧ (∀i ∈ [0, v_2.len - 1] : (if v_3 < 0 then v_2[i] ≥ 0 - shape(v_1, v_3 + ndim(v_1)) ∧ v_2[i] < shape(v_1, v_3 + ndim(v_1)) else v_2[i] ≥ 0 - shape(v_1, v_3) ∧ v_2[i] < shape(v_1, v_3)))
>>
Rule 9 (kth as a tuple of integers must have elements within the partition axis bounds)
{v_1 : tensor, v_2 : tuple(int), v_3 : int} |= v_2.len > 0 ∧ (∀i ∈ [0, v_2.len - 1] : (if v_3 < 0 then v_2[i] ≥ 0 - shape(v_1, v_3 + ndim(v_1)) ∧ v_2[i] < shape(v_1, v_3 + ndim(v_1)) else v_2[i] ≥ 0 - shape(v_1, v_3) ∧ v_2[i] < shape(v_1, v_3)))
>>
Rule 10 (the input tensor must have a valid non-complex numeric or boolean dtype)
{v_1 : tensor} |= dtype_(v_1) ≤ 8
>>
Rule 12 (the axis must be within the bounds of the tensor's dimensions)
{v_1 : tensor, v_3 : int} |= (if ndim(v_1) = 1 then v_3 = 0 ∨ v_3 = 0 - 1 else (if v_3 ≥ 0 then v_3 < ndim(v_1) else v_3 ≥ 0 - ndim(v_1)))
>>
Rule 13 (the size of the partitioned axis must be greater than zero)
{v_1 : tensor, v_3 : int} |= (if v_3 ≥ 0 then shape(v_1, v_3) > 0 else shape(v_1, v_3 + ndim(v_1)) > 0)
>>
Rule 14 (the kth index must be within the size of the partitioned dimension)
{v_1 : tensor, v_2 : int, v_3 : int} |= (if v_3 ≥ 0 then (if v_2 ≥ 0 then v_2 < shape(v_1, v_3) else v_2 ≥ 0 - shape(v_1, v_3)) else (if v_2 ≥ 0 then v_2 < shape(v_1, v_3 + ndim(v_1)) else v_2 ≥ 0 - shape(v_1, v_3 + ndim(v_1))))
