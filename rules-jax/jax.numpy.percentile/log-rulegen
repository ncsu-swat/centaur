    >>> x = jnp.array([1, 2, 3, 4, 5])
    >>> weights = jnp.array([1, 1, 2, 1, 1])
    >>> jnp.percentile(x, 50, weights=weights, method='inverted_cdf')
    Array(3., dtype=float32)

