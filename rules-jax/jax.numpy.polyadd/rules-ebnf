Rule 1 (both input tensors must be at least 1-dimensional)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 2 (input tensors must have numeric dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) < 11 ∧ dtype_(v_2) < 11
>>
Rule 3 (dimension compatibility for different dimensional inputs)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) then (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 1) else (if ndim(v_2) > ndim(v_1) then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1))
>>
Rule 4 (all dimension sizes of both input tensors must be greater than zero)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 6 (both input tensors must have numeric data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≥ 1 ∧ dtype_(v_2) ≤ 10
>>
Rule 7 (non-polynomial dimensions must be compatible for broadcasting when they have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) > 1 then ∀i ∈ [0, ndim(v_1) - 2] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 8 (input tensors should have matching data types to prevent implicit type promotion)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 9 (dimension sizes of the first input tensor must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 10 (dimension sizes of the second input tensor must be positive)
{v_2 : tensor} |= ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
