Rule 2 (axis parameter must be within the valid range of tensor dimensions)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 1 ∧ 0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 3 (start parameter must be within the valid range of tensor dimensions)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 1 ∧ 0 - ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1)
>>
Rule 7 (both axis and start parameters must be valid dimension indices)
{v_1 : tensor, v_2 : int, v_3 : int} |= ndim(v_1) ≥ 1 ∧ 0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1) ∧ 0 - ndim(v_1) ≤ v_3 ∧ v_3 ≤ ndim(v_1)
>>
Rule 8 (if input tensor is 1D, axis must be 0 or -1; otherwise, it must be a valid axis index)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then (v_2 = 0 ∨ v_2 = 0 - 1) else (0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1))
>>
Rule 9 (if input tensor is 1D, start must be in [-1, 1]; otherwise, it must be a valid start index)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then (v_2 = 0 - 1 ∨ v_2 = 0 ∨ v_2 = 1) else (0 - ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1))
>>
Rule 10 (both axis and start parameters must be within valid bounds of the input tensor)
{v_1 : tensor, v_2 : int, v_3 : int} |= ndim(v_1) > 0 ∧ (0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)) ∧ (0 - ndim(v_1) ≤ v_3 ∧ v_3 ≤ ndim(v_1))
>>
Rule 11 (input tensor must have a dimension of at least 1)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 12 (input tensor must have positive size for all dimensions)
{v_1 : tensor} |= ndim(v_1) > 0 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 13 (axis and start parameters must be valid dimension indices for the input tensor)
{v_1 : tensor, v_2 : int, v_3 : int} |= ndim(v_1) > 0 ∧ (if v_2 < 0 then 0 - ndim(v_1) ≤ v_2 else v_2 < ndim(v_1)) ∧ (if v_3 < 0 then 0 - ndim(v_1) ≤ v_3 else v_3 ≤ ndim(v_1))
