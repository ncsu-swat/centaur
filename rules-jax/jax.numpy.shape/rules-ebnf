Rule 1 (dimension sizes of the input tensor must be non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 2 (boolean scalar input must be true or false)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 3 (numeric scalar input must be a valid real number)
{v_1 : int ⊎ float} |= v_1 ≥ 0 ∨ v_1 < 0
>>
Rule 5 (rank of the input tensor must not exceed 64)
{v_1 : tensor} |= ndim(v_1) ≤ 64
>>
Rule 7 (scalar numeric input must be a valid real number)
{v_1 : int ⊎ float} |= v_1 - v_1 = 0
>>
Rule 8 (input tensor must not be empty and must have positive dimension sizes)
{v_1 : tensor} |= ndim(v_1) > 0 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 9 (integer scalar input must be within a reasonable bounds)
{v_1 : int} |= v_1 > -100000 ∧ v_1 < 100000
>>
Rule 10 (float scalar input must be within a safe range)
{v_1 : float} |= v_1 > -1000.0 ∧ v_1 < 1000.0
>>
Rule 11 (boolean scalar input self-consistency check)
{v_1 : bool} |= if v_1 = true then v_1 ≠ false else v_1 ≠ true
>>
Rule 12 (2-dimensional tensor with all positive shape dimensions)
{v_1 : tensor} |= ndim(v_1) = 2 ∧ shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 13 (square of numeric scalar input is non-negative)
{v_1 : int ⊎ float} |= v_1 * v_1 ≥ 0
>>
Rule 14 (boolean scalar input value consistency)
{v_1 : bool} |= if v_1 then v_1 = true else v_1 = false
>>
Rule 15 (1-dimensional tensor with a positive shape dimension)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ shape(v_1, 0) > 0
