Rule 3 (input tensor should not exceed 10 dimensions)
{v_1 : tensor} |= ndim(v_1) ≤ 10
>>
Rule 4 (all dimensions of the input tensor must have a positive size)
{v_1 : tensor} |= if ndim(v_1) > 0 then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0)
>>
Rule 5 (tuple of inputs must have a positive length)
{v_1 : tuple(int) ⊎ tuple(float)} |= v_1.len > 0
>>
Rule 6 (list of float inputs must contain only non-negative values to avoid nan outputs)
{v_1 : list(float)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 7 (real-valued tensor inputs must have non-negative elements to prevent nan results)
{v_1 : tensor} |= if dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 8 then min(v_1) ≥ 0
>>
Rule 8 (if the input tensor has at least one dimension, the first dimension size must be positive)
{v_1 : tensor} |= if ndim(v_1) ≥ 1 then shape(v_1, 0) > 0
>>
Rule 9 (for a list of integers, elements must be non-negative and the list must not be empty)
{v_1 : list(int)} |= v_1.len > 0 ∧ (∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0)
>>
Rule 10 (boolean tensor inputs must have a minimum value of 0 or 1)
{v_1 : tensor} |= if dtype_(v_1) = 0 then min(v_1) = 0 ∨ min(v_1) = 1
>>
Rule 11 (the tensor dimension of the input should be within a standard range of 0 to 8)
{v_1 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_1) ≤ 8
>>
Rule 12 (if the input is a scalar integer or float, its value should be within a safe numerical range)
{v_1 : int ⊎ float} |= v_1 ≥ -1000000 ∧ v_1 ≤ 1000000
>>
Rule 13 (list of floats must contain reasonably bounded elements)
{v_1 : list(float)} |= v_1.len > 0 ∧ (∀i ∈ [0, v_1.len - 1] : v_1[i] ≤ 1000000000 ∧ v_1[i] ≥ -1000000000)
>>
Rule 14 (tuple representing input scalars has a size limit)
{v_1 : tuple(int) ⊎ tuple(float)} |= v_1.len > 0 ∧ v_1.len ≤ 5
>>
Rule 15 (complex-valued tensors should not have high dimensions)
{v_1 : tensor} |= if dtype_(v_1) ≥ 9 ∧ dtype_(v_1) ≤ 10 then ndim(v_1) ≤ 4
>>
Rule 16 (if input is a scalar, boolean values are always valid and numerical values should be non-negative)
{v_1 : int ⊎ float ⊎ bool} |= if v_1 = true then true else (if v_1 = false then true else v_1 ≥ 0)
