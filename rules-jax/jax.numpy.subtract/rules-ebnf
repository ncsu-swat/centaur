>>
Rule 1 (tensors must not have string dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_2) ≠ 11
>>
Rule 2 (tensors of the same rank must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 3 (tensors must be broadcastable when the first tensor has a higher rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) then (∀ i ∈ [0, ndim(v_2) - 1] : shape(v_1, ndim(v_1) - ndim(v_2) + i) = shape(v_2, i) ∨ shape(v_1, ndim(v_1) - ndim(v_2) + i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 4 (tensors must be broadcastable when the second tensor has a higher rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < ndim(v_2) then (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_2, ndim(v_2) - ndim(v_1) + i) = shape(v_1, i) ∨ shape(v_2, ndim(v_2) - ndim(v_1) + i) = 1 ∨ shape(v_1, i) = 1)
>>
Rule 7 (specified output dtype must be a valid numeric or boolean dtype)
{v_3 : dtype} |= v_3 ≤ 10
>>
Rule 8 (the boolean mask 'where' must be broadcastable with the first input tensor)
{v_1 : tensor, v_3 : tensor} |= if ndim(v_1) = ndim(v_3) then (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_3, i) ∨ shape(v_3, i) = 1)
>>
Rule 9 (the boolean mask 'where' must be of boolean type)
{v_3 : tensor} |= dtype_(v_3) = 0
>>
Rule 10 (non-empty shape dimensions for both input tensors)
{v_1 : tensor, v_2 : tensor} |= (∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀ j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 12 (dtypes of both input tensors must be numeric or boolean)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≤ 10
>>
Rule 13 (subtracting an integer scalar within a safe range from a numeric tensor)
{v_1 : tensor, v_2 : int} |= dtype_(v_1) ≤ 10 ∧ v_2 < 1000000 ∧ v_2 > -1000000
>>
Rule 14 (subtracting a float scalar within a safe range from a numeric tensor)
{v_1 : tensor, v_2 : float} |= dtype_(v_1) ≤ 10 ∧ v_2 < 1000000.0 ∧ v_2 > -1000000.0
>>
Rule 15 (input tensor and specified output dtype must both be numeric or boolean)
{v_1 : tensor, v_2 : dtype} |= dtype_(v_1) ≤ 10 ∧ v_2 ≤ 10
>>
Rule 16 (subtracting a union scalar within a safe range from a numeric tensor)
{v_1 : tensor, v_2 : int ⊎ float} |= dtype_(v_1) ≤ 10 ∧ v_2 < 1000000 ∧ v_2 > -1000000
