Rule 1 (dimension compatibility when axes is an integer)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= v_3 ≥ 0 ∧ v_3 ≤ ndim(v_1) ∧ v_3 ≤ ndim(v_2) ∧ (∀i ∈ [0, v_3 - 1] : shape(v_1, ndim(v_1) - v_3 + i) = shape(v_2, i))
>>
Rule 2 (axes as a tuple of two integers must specify valid dimensions and have matching shapes)
{v_1 : tensor, v_2 : tensor, v_3 : tuple(int)} |= v_3.len = 2 ∧ v_3[0] ≥ 0 ∧ v_3[0] < ndim(v_1) ∧ v_3[1] ≥ 0 ∧ v_3[1] < ndim(v_2) ∧ shape(v_1, v_3[0]) = shape(v_2, v_3[1])
>>
Rule 3 (axes as a list of two integers must specify valid dimensions and have matching shapes)
{v_1 : tensor, v_2 : tensor, v_3 : list(int)} |= v_3.len = 2 ∧ v_3[0] ≥ 0 ∧ v_3[0] < ndim(v_1) ∧ v_3[1] ≥ 0 ∧ v_3[1] < ndim(v_2) ∧ shape(v_1, v_3[0]) = shape(v_2, v_3[1])
>>
Rule 4 (input tensors must have matching data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 5 (minimum input tensor dimensions required for positive axes value)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= if v_3 ≥ 1 then ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 6 (precision parameter must be set to none if provided as a string)
{v_4 : str} |= v_4 = "none"
>>
Rule 7 (dimension compatibility when axes is a positive integer)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= v_3 ≥ 0 ∧ (if v_3 > 0 then v_3 ≤ ndim(v_1) ∧ v_3 ≤ ndim(v_2) ∧ (∀i ∈ [0, v_3 - 1] : shape(v_1, ndim(v_1) - v_3 + i) = shape(v_2, i)))
>>
Rule 10 (preferred element type must be a valid numeric dtype)
{v_5 : dtype} |= v_5 ≥ 1 ∧ v_5 ≤ 10
>>
Rule 12 (tensor dimensions must be non-empty and non-zero)
{v_1 : tensor} |= ndim(v_1) ≥ 0 ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0)
