>>
Rule 1 (dimension of array to integrate must be at least 1)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (axis of integration must be within valid range for the input tensor)
{v_1 : tensor, v_2 : int} |= v_2 + ndim(v_1) ≥ 0 ∧ v_2 < ndim(v_1)
>>
Rule 3 (spacing dx must be non-zero)
{v_1 : int ⊎ float} |= v_1 ≠ 0
>>
Rule 4 (input tensor y must have a numeric dtype)
{v_1 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 10
>>
Rule 5 (if sample points x are provided, its shape must match y's shape, or it must be 1D with size matching y's shape along the integration axis)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= v_3 + ndim(v_1) ≥ 0 ∧ v_3 < ndim(v_1) ∧ (if ndim(v_2) = 1 then shape(v_2, 0) = shape(v_1, if v_3 < 0 then v_3 + ndim(v_1) else v_3) else (ndim(v_2) = ndim(v_1) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i))))
>>
Rule 9 (spacing dx must be a 0D or 1D tensor if it is a tensor)
{v_1 : tensor} |= ndim(v_1) ≤ 1
>>
Rule 12 (size of the integration dimension must be at least 2 to apply the trapezoidal rule)
{v_1 : tensor, v_2 : int} |= shape(v_1, if v_2 < 0 then v_2 + ndim(v_1) else v_2) ≥ 2
>>
Rule 13 (dimensionality of sample points x must not exceed that of y)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ ndim(v_2)
>>
Rule 14 (axis of integration must be within valid range)
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 - ndim(v_1) ∧ v_2 < ndim(v_1)
>>
Rule 15 (sample points x must have a real-valued numeric dtype)
{v_1 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 8
>>
Rule 16 (if sample points x is 1D, its length must be at least 2)
{v_1 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) ≥ 2
>>
Rule 18 (y must be of a numeric data type)
{v_1 : tensor} |= dtype_(v_1) ≤ 10
>>
Rule 19 (axis must be a valid dimension index of y)
{v_1 : tensor, v_2 : int} |= v_2 < ndim(v_1) ∧ v_2 ≥ 0 - ndim(v_1)
>>
Rule 20 (if x and y have the same number of dimensions, their shapes must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 21 (if x is a tensor, its number of dimensions must be either 1 or equal to y)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = 1 ∨ ndim(v_2) = ndim(v_1)
>>
Rule 22 (if dx is a tensor, it must be a 0-dimensional scalar)
{v_1 : tensor} |= ndim(v_1) = 0
>>
Rule 25 (if x is a tensor, its length along the integration axis or its overall shape must match y)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= if ndim(v_2) = 1 then shape(v_2, 0) = (if v_3 ≥ 0 then shape(v_1, v_3) else shape(v_1, ndim(v_1) + v_3)) else if ndim(v_2) = ndim(v_1) then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i)) else false
>>
Rule 26 (spacing dx must be a positive number)
{v_1 : float ⊎ int} |= v_1 > 0
>>
Rule 27 (y and x must both be numeric tensors)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≤ 10
>>
Rule 28 (if y is 1-D, the integration axis must be 0 or -1)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then v_2 = 0 ∨ v_2 = -1
>>
Rule 29 (the dimension of y along the integration axis must be at least 2 to compute trapezoids)
{v_1 : tensor, v_2 : int} |= (if v_2 ≥ 0 then shape(v_1, v_2) else shape(v_1, ndim(v_1) + v_2)) ≥ 2
>>
Rule 30 (if x is a 1-D tensor, its length must match the integration dimension of y)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= if ndim(v_2) = 1 then shape(v_2, 0) = (if v_3 ≥ 0 then shape(v_1, v_3) else shape(v_1, ndim(v_1) + v_3))
>>
Rule 31 (if x is a multi-dimensional tensor, its shape must fully match y)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 1 then ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 32 (if y and x are both provided, neither should be of string type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_2) ≠ 11
>>
Rule 34 (if spacing dx is provided as a tensor, it must be a 0-D numeric scalar)
{v_1 : tensor} |= ndim(v_1) = 0 ∧ dtype_(v_1) ≠ 11
