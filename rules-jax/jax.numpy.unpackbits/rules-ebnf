>>
Rule 1 (dtype of input tensor must be uint8)
{v_1 : tensor} |= dtype_(v_1) = 5
>>
Rule 2 (axis must be within the valid range of dimensions of the input tensor)
{v_1 : tensor, v_2 : int} |= v_2 + ndim(v_1) ≥ 0 ∧ v_2 < ndim(v_1)
>>
Rule 3 (absolute value of count must not exceed the total number of bits along the specified axis)
{v_1 : tensor, v_2 : int, v_3 : int} |= (if v_3 < 0 then 0 - v_3 else v_3) ≤ (if v_2 ≥ 0 then shape(v_1, v_2) else shape(v_1, v_2 + ndim(v_1))) * 8
>>
Rule 8 (absolute value of negative axis must not exceed the number of dimensions of the input tensor)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then 0 - v_2 ≤ ndim(v_1)
>>
Rule 9 (if the input tensor has 0 elements along the first dimension, count must be 0)
{v_1 : tensor, v_3 : int} |= if shape(v_1, 0) = 0 then v_3 = 0
>>
Rule 10 (when unpacking along axis 0, the absolute value of count must not exceed 8 times the size of the first dimension)
{v_1 : tensor, v_2 : int, v_3 : int} |= if v_2 = 0 then (if v_3 ≥ 0 then v_3 else 0 - v_3) ≤ shape(v_1, 0) * 8
