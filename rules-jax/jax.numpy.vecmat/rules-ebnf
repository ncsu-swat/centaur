>>
Rule 1 (first input tensor must have at least 1 dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (second input tensor must have at least 2 dimensions)
{v_2 : tensor} |= ndim(v_2) ≥ 2
>>
Rule 3 (contracted core dimension of x1 and x2 must match)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 4 (batch dimensions must be broadcast-compatible when both inputs have identical batch rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) - 1 = ndim(v_2) - 2 then ∀i ∈ [0, ndim(v_1) - 2] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 9 (inputs must have numeric or boolean data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≤ 10
>>
Rule 10 (both input tensors must have sufficient dimensions for core vector and matrix shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 2
>>
Rule 11 (contracted core dimension of vector and matrix must match when dimensional requirements are met)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 2 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2) else false
>>
Rule 12 (the trailing batch dimensions must be broadcast-compatible when both inputs have batch dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 3 then shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 3) ∨ shape(v_1, ndim(v_1) - 2) = 1 ∨ shape(v_2, ndim(v_2) - 3) = 1
>>
Rule 17 (second-from-trailing batch dimension must be broadcast-compatible when present in both tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 3 ∧ ndim(v_2) ≥ 4 then shape(v_1, ndim(v_1) - 3) = shape(v_2, ndim(v_2) - 4) ∨ shape(v_1, ndim(v_1) - 3) = 1 ∨ shape(v_2, ndim(v_2) - 4) = 1
>>
Rule 18 (first input tensor must have rank greater than zero)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 19 (second input tensor must have rank greater than one to supply matrix core dimensions)
{v_2 : tensor} |= ndim(v_2) > 1
>>
Rule 20 (contracted dimension size of matrix core must equal vector dimension size)
{v_1 : tensor, v_2 : tensor} |= shape(v_2, ndim(v_2) - 2) = shape(v_1, ndim(v_1) - 1)
>>
Rule 21 (trailing batch dimension of both inputs must match or be broadcastable)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 1 ∧ ndim(v_2) > 2 then shape(v_2, ndim(v_2) - 3) = shape(v_1, ndim(v_1) - 2) ∨ shape(v_2, ndim(v_2) - 3) = 1 ∨ shape(v_1, ndim(v_1) - 2) = 1
