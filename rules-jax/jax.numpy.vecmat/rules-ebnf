>>
Rule 1 (minimum dimensions of input tensors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 2
>>
Rule 2 (size of contracting dimension must match in both inputs)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 3 (all shape dimensions of the vector tensor must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 4 (all shape dimensions of the matrix tensor must be positive)
{v_2 : tensor} |= ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 6 (matching contraction dimension between vector and matrix)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 9 (broadcasting compatibility for a single batch dimension)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 3 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 11 (broadcasting compatibility when vector has fewer or equal batch dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 2] : shape(v_1, i) = shape(v_2, i + ndim(v_2) - ndim(v_1) - 1) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i + ndim(v_2) - ndim(v_1) - 1) = 1
>>
Rule 12 (broadcasting compatibility when matrix has fewer batch dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ ndim(v_2) then ∀i ∈ [0, ndim(v_2) - 3] : shape(v_2, i) = shape(v_1, i + ndim(v_1) - ndim(v_2) + 1) ∨ shape(v_2, i) = 1 ∨ shape(v_1, i + ndim(v_1) - ndim(v_2) + 1) = 1
>>
Rule 13 (inputs must have numeric or boolean data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) < 11 ∧ dtype_(v_2) < 11
>>
Rule 14 (dimension matching for standard 1D-2D vector-matrix product)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 18 (dimension matching for batched vector-matrix product where matrix is 2D)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 1) = shape(v_2, 0)
>>
Rule 21 (inputs must have numeric or boolean dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≤ 10
>>
Rule 22 (batch dimension broadcast compatibility for 2D and 3D inputs)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 2 ∧ ndim(v_2) = 3 ∧ (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1)
>>
Rule 23 (non-batched case vector-matrix dimension match)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 2 ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 25 (all dimensions of both tensors must be non-empty)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 26 (inputs must belong to the same category of dtypes)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) ≤ 5 ∧ dtype_(v_2) ≤ 5) ∨ (dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≥ 6 ∧ dtype_(v_2) ≤ 10)
>>
Rule 27 (vector dimension matching for 2D matrix input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) = 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, 0)
>>
Rule 29 (matrix input must be at least 2D)
{v_2 : tensor} |= ndim(v_2) ≥ 2
>>
Rule 32 (vector dimension matching for 3D vector and 2D matrix)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 3 ∧ ndim(v_2) = 2 then shape(v_1, 2) = shape(v_2, 0)
