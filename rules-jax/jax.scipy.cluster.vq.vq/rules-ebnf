Rule 1 (obs must be 1-dimensional or 2-dimensional)
{v_1 : tensor} |= ndim(v_1) = 1 ∨ ndim(v_1) = 2
>>
Rule 2 (code_book must be 1-dimensional or 2-dimensional)
{v_2 : tensor} |= ndim(v_2) = 1 ∨ ndim(v_2) = 2
>>
Rule 3 (obs and code_book must have positive sizes along the first dimension)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) > 0 ∧ shape(v_2, 0) > 0
>>
Rule 4 (dimension sizes of individual observation vectors and codes must match)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 1 ∧ ndim(v_2) = 1) ∨ (ndim(v_1) = 2 ∧ ndim(v_2) = 1 ∧ shape(v_1, 1) = 1) ∨ (ndim(v_1) = 1 ∧ ndim(v_2) = 2 ∧ shape(v_2, 1) = 1) ∨ (ndim(v_1) = 2 ∧ ndim(v_2) = 2 ∧ shape(v_1, 1) = shape(v_2, 1))
>>
Rule 5 (obs and code_book must be of floating-point types)
{v_1 : tensor, v_2 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 ∧ 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 6 (obs and code_book must have matching dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 7 (check_finite is a boolean value)
{v_3 : bool} |= v_3 = true ∨ v_3 = false
>>
Rule 8 (dimension of observation vectors must be 1 or 2)
{v_1 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_1) ≤ 2
>>
Rule 9 (dimension of code book must be 1 or 2)
{v_2 : tensor} |= ndim(v_2) ≥ 1 ∧ ndim(v_2) ≤ 2
>>
Rule 10 (observation vectors and code book must have at least one element along the first dimension)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) ≥ 1 ∧ shape(v_2, 0) ≥ 1
>>
Rule 11 (the number of features in observation vectors must match the number of features in the code book)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) = 2 then shape(v_1, 1) else 1) = (if ndim(v_2) = 2 then shape(v_2, 1) else 1)
>>
Rule 12 (observation vectors and code book must have the same floating-point data type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 8
