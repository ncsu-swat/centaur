>>
Rule 1 (dimension of y must be at least 1)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (axis must be a valid axis of y)
{v_1 : tensor, v_2 : int} |= -1 * ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 3 (x, if a tensor, must have dimension 1 or equal to the dimension of y)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = 1 ∨ ndim(v_2) = ndim(v_1)
>>
Rule 4 (if x is 1D, its length must match the size of y along the integration axis)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= if ndim(v_2) = 1 then shape(v_2, 0) = shape(v_1, if v_3 < 0 then v_3 + ndim(v_1) else v_3)
>>
Rule 5 (if x has the same dimension as y, its shape must match y's shape)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = ndim(v_1) then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i))
>>
Rule 6 (spacing between sample points must be positive)
{v_1 : int ⊎ float} |= v_1 > 0
>>
Rule 9 (y and x must be of numeric types)
{v_1 : tensor, v_2 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 ∧ 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10
