>>
Rule 1 (input tensor a must be at least 2-dimensional)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (input tensor a must have equal sizes for its last two dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 3 (all dimensions of input tensor a must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 7 (input tensor a must have floating-point or complex data type)
{v_1 : tensor} |= dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 10
>>
Rule 8 (if check_finite is enabled, the matrix dimension must be greater than or equal to 1)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then shape(v_1, ndim(v_1) - 1) ≥ 1
>>
Rule 9 (if the input tensor has 2 dimensions, its first dimension must be greater than or equal to 1)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) ≥ 1
>>
Rule 12 (All batch dimensions of the input tensor must be positive)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) > 0
