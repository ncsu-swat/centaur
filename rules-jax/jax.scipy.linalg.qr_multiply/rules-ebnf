{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 ∧ ndim(v_2) = 1 then shape(v_2, 0) ≤ shape(v_1, ndim(v_1) - 2) ∧ shape(v_2, 0) > 0
