Rule 1 (dimension of tensor a must be at least 2)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (dimension of tensor c must be at least 1)
{v_2 : tensor} |= ndim(v_2) ≥ 1
>>
Rule 3 (mode parameter must be either 'left' or 'right')
{v_3 : str} |= v_3 = "left" ∨ v_3 = "right"
>>
Rule 4 (if mode is left and c is 1-dimensional, its size must match min(M, N))
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "left" ∧ ndim(v_2) = 1 ∧ ndim(v_1) ≥ 2 then (if shape(v_1, ndim(v_1) - 2) < shape(v_1, ndim(v_1) - 1) then shape(v_2, 0) = shape(v_1, ndim(v_1) - 2) else shape(v_2, 0) = shape(v_1, ndim(v_1) - 1))
>>
Rule 5 (if mode is right and c is 1-dimensional, its size must match M)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "right" ∧ ndim(v_2) = 1 ∧ ndim(v_1) ≥ 2 then shape(v_2, 0) = shape(v_1, ndim(v_1) - 2)
>>
Rule 6 (if mode is left and c is at least 2-dimensional, the second-to-last dimension of c must match min(M, N))
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "left" ∧ ndim(v_2) ≥ 2 ∧ ndim(v_1) ≥ 2 then (if shape(v_1, ndim(v_1) - 2) < shape(v_1, ndim(v_1) - 1) then shape(v_2, ndim(v_2) - 2) = shape(v_1, ndim(v_1) - 2) else shape(v_2, ndim(v_2) - 2) = shape(v_1, ndim(v_1) - 1))
>>
Rule 7 (if mode is right and c is at least 2-dimensional, the last dimension of c must match M)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "right" ∧ ndim(v_2) ≥ 2 ∧ ndim(v_1) ≥ 2 then shape(v_2, ndim(v_2) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 8 (tensors must not be empty)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 9 (data type of a must be float or complex)
{v_1 : tensor} |= dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 10
>>
Rule 12 (data type of both tensors must be floating-point or complex)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 10) ∧ (dtype_(v_2) ≥ 6 ∧ dtype_(v_2) ≤ 10)
>>
Rule 13 (if c is 1-dimensional, its length must match M or min(M, N))
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 1 ∧ ndim(v_1) ≥ 2 then shape(v_2, 0) = shape(v_1, ndim(v_1) - 2) ∨ shape(v_2, 0) = (if shape(v_1, ndim(v_1) - 2) < shape(v_1, ndim(v_1) - 1) then shape(v_1, ndim(v_1) - 2) else shape(v_1, ndim(v_1) - 1))
>>
Rule 14 (if c is 2-dimensional or higher, either its last dimension matches M or its second-to-last dimension matches min(M, N))
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) ≥ 2 ∧ ndim(v_1) ≥ 2 then shape(v_2, ndim(v_2) - 1) = shape(v_1, ndim(v_1) - 2) ∨ shape(v_2, ndim(v_2) - 2) = (if shape(v_1, ndim(v_1) - 2) < shape(v_1, ndim(v_1) - 1) then shape(v_1, ndim(v_1) - 2) else shape(v_1, ndim(v_1) - 1))
>>
Rule 15 (batch dimensions compatibility of a and c when they have the same rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) > 2 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) = shape(v_2, i)
>>
Rule 16 (all shape dimensions of input tensor a must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 17 (all shape dimensions of input tensor c must be positive)
{v_2 : tensor} |= ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
