>>
Rule 1 (input tensor must be at least 2-dimensional)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (input tensor must have a floating-point or complex data type)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 3 (the size of the last two dimensions of the input tensor must be greater than zero)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) > 0 ∧ shape(v_1, ndim(v_1) - 2) > 0
>>
Rule 6 (input tensor must not contain any zero-sized dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 7 (default LAPACK driver string should be "none")
{v_6 : str} |= v_6 = "none"
>>
Rule 8 (input tensor must have a floating-point or complex data type)
{v_1 : tensor} |= dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 10
>>
Rule 9 (input tensor must have at least 2 dimensions and the core matrix dimensions must be non-empty)
{v_1 : tensor} |= ndim(v_1) > 1 ∧ shape(v_1, ndim(v_1) - 1) > 0 ∧ shape(v_1, ndim(v_1) - 2) > 0
>>
Rule 10 (if the tensor is batched, all batch dimensions must be greater than zero)
{v_1 : tensor} |= if ndim(v_1) > 2 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) > 0
>>
Rule 12 (the core matrix dimensions of the input tensor must be non-empty)
{v_1 : tensor} |= ndim(v_1) > 1 ∧ shape(v_1, ndim(v_1) - 1) * shape(v_1, ndim(v_1) - 2) > 0
>>
Rule 13 (the input tensor must have a floating-point or complex data type)
{v_1 : tensor} |= dtype_(v_1) > 5 ∧ dtype_(v_1) < 11
>>
Rule 14 (all dimensions of a batched or 2D input tensor must be greater than zero)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 else ndim(v_1) > 2 ∧ ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) > 0
>>
Rule 15 (allowed values for the lapack_driver parameter)
{v_6 : str} |= v_6 = "none" ∨ v_6 = "float32" ∨ v_6 = "bfloat16"
