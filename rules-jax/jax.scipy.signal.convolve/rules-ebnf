{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "valid" then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ shape(v_2, i)
>>
Rule 3 (precision tuple length restriction)
{v_5 : tuple(str)} |= v_5.len = 2
>>
Rule 4 (minimum dimensions of input tensor)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 5 (input tensor must not contain zero-sized dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 8 (precision tuple length and contents constraint)
{v_5 : tuple(str)} |= v_5.len = 2 ∧ (v_5[0] = "highest" ∨ v_5[0] = "float32" ∨ v_5[0] = "bfloat16") ∧ (v_5[1] = "highest" ∨ v_5[1] = "float32" ∨ v_5[1] = "bfloat16")
>>
Rule 9 (allowed mode values constraint)
{v_3 : str} |= v_3 = "same" ∨ v_3 = "valid"
>>
Rule 10 (input tensors must be at least 1-dimensional and non-empty)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 11 (dimensions of both input tensors must be equal)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≤ ndim(v_2) ∧ ndim(v_2) ≤ ndim(v_1)
>>
Rule 12 (size constraint on input tensors for valid convolution mode)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "valid" then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) - shape(v_2, i) ≥ 0
>>
Rule 13 (data type of both input tensors must be identical)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 15 (precision as a string must be one of the recognized computing precision types)
{v_5 : str} |= v_5 = "highest" ∨ v_5 = "float32" ∨ v_5 = "bfloat16"
