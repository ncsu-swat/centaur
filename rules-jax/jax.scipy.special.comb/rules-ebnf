>>
Rule 1 (N and k as integers must be non-negative)
{v_1 : int, v_2 : int} |= v_1 ≥ 0 ∧ v_2 ≥ 0
>>
Rule 2 (N and k as tensors must have non-negative values)
{v_1 : tensor, v_2 : tensor} |= ((∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ min(v_1) ≥ 0) ∧ ((∃j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) = 0) ∨ min(v_2) ≥ 0)
>>
Rule 4 (tensor inputs N and k must have the same shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 5 (If repetition is true, N must be a positive integer)
{v_1 : int, v_4 : bool} |= if v_4 = true then v_1 ≥ 1
>>
Rule 8 (tensor inputs require exact to be false)
{v_1 : tensor, v_3 : bool} |= ndim(v_1) ≥ 0 ∧ v_3 = false
>>
Rule 9 (broadcasting compatibility for tensor shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 11 (N must be an integer or floating-point tensor)
{v_1 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 8
