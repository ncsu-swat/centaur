Rule 1 (input tensor must have floating-point or complex data type)
{v_1 : tensor} |= dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 10
>>
Rule 2 (input tensor must be at least 0-dimensional)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 4 (input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 5 (input tensor must not be empty)
{v_1 : tensor} |= ndim(v_1) ≥ 1 ∧ ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 6 (the input tensor must not have boolean data type)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 7 (the input tensor must be of float32 or float64 data type)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 8 (input tensor must have fewer than 6 dimensions)
{v_1 : tensor} |= ndim(v_1) < 6
>>
Rule 9 (A 1-dimensional input tensor must have a positive size)
{v_1 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) > 0
>>
Rule 10 (A 2-dimensional input tensor must have positive sizes for both dimensions)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 11 (The input tensor cannot be of complex128 type)
{v_1 : tensor} |= dtype_(v_1) ≠ 10
