Rule 1 (broadcasting compatibility for tensor shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 2 (p and q must be real-valued floating point arrays)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 3 (p and q should have identical data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (Tensors must be real-valued and non-complex)
{v_1 : tensor, v_2 : tensor} |= (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) ∧ (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8)
>>
Rule 5 (If both tensors have the same number of dimensions and are not scalar, their leading dimensions must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) > 0 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 8 (equal length when both inputs are 1D)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 9 (inputs must be real-valued and non-complex)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 8 ∧ dtype_(v_2) ≤ 8
>>
Rule 10 (dimension rank of input tensors must not exceed 4)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≤ 4 ∧ ndim(v_2) ≤ 4
>>
Rule 11 (last dimension matching if both inputs are non-scalar)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 12 (non-empty shape dimensions for non-scalar inputs)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) > 0 then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0)) ∧ (if ndim(v_2) > 0 then (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0))
>>
Rule 13 (input tensors must be real-valued, meaning non-complex)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) < 9 ∧ dtype_(v_2) < 9
>>
Rule 15 (if both are 2-dimensional tensors, their second dimension must be equal)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 1) = shape(v_2, 1)
