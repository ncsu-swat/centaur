Rule 5 (broadcasting compatibility for parameters a and b)
{a : tensor, b : tensor} |= ndim(a) > 0 ∧ ndim(b) > 0 ∧ ∀i ∈ [0, if ndim(a) ≥ ndim(b) then ndim(a) - 1 else ndim(b) - 1] : ndim(a) - i - 1 < 0 ∨ ndim(b) - i - 1 < 0 ∨ shape(a, ndim(a) - i - 1) = 1 ∨ shape(b, ndim(b) - i - 1) = 1 ∨ shape(a, ndim(a) - i - 1) = shape(b, ndim(b) - i - 1)
>>
Rule 6 (broadcasting compatibility for parameters x and loc)
{x : tensor, loc : tensor} |= ndim(x) > 0 ∧ ndim(loc) > 0 ∧ ∀i ∈ [0, if ndim(x) ≥ ndim(loc) then ndim(x) - 1 else ndim(loc) - 1] : ndim(x) - i - 1 < 0 ∨ ndim(loc) - i - 1 < 0 ∨ shape(x, ndim(x) - i - 1) = 1 ∨ shape(loc, ndim(loc) - i - 1) = 1 ∨ shape(x, ndim(x) - i - 1) = shape(loc, ndim(loc) - i - 1)
>>
Rule 7 (parameters a and b must be strictly positive)
{v_1 : tensor, v_2 : tensor} |= min(v_1) > 0 ∧ min(v_2) > 0
>>
Rule 8 (scale parameter must be strictly positive)
{v_1 : tensor} |= min(v_1) > 0
>>
Rule 9 (parameter x must be of a floating-point type)
{v_1 : tensor} |= dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 8
>>
Rule 10 (parameters a and b should have matching data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 11 (broadcasting compatibility for shape parameters a and b)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 14 (The dimension of parameter scale should be non-empty)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 15 (If loc and scale have the same rank, they must have matching shapes)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 16 (The number of dimensions of a tensor must not exceed 8)
{v_1 : tensor} |= ndim(v_1) ≤ 8
>>
Rule 17 (The absolute difference between the number of dimensions of two tensors must not exceed 2)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) - ndim(v_2) ≤ 2 ∧ ndim(v_2) - ndim(v_1) ≤ 2
>>
Rule 18 (Broadcast compatibility on the last dimension of two tensors)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ((shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)) ∨ (shape(v_1, ndim(v_1) - 1) = 1)) ∨ (shape(v_2, ndim(v_2) - 1) = 1)
>>
Rule 19 (If a tensor is at least 2-dimensional, its second dimension must be positive)
{v_1 : tensor} |= if ndim(v_1) > 1 then shape(v_1, 1) > 0
>>
Rule 20 (If shape parameter a is 1-dimensional, its length must not exceed the last dimension of the input x)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) > 0 then shape(v_1, 0) ≤ shape(v_2, ndim(v_2) - 1)
>>
Rule 21 (If scale and loc are both 2-dimensional, their first dimensions must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 22 (The shape parameters must be non-empty and strictly positive)
{v_1 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ min(v_1) > 0
>>
Rule 23 (If shape parameters a and b have equal non-zero rank, their last dimensions must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) > 0 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
