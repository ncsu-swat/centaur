Rule 1 (x must have floating-point dtype)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 2 (df (degrees of freedom) must be strictly positive)
{v_1 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ min(v_1) > 0
>>
Rule 4 (broadcasting compatibility for x and df)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 6 (all input tensors must be of floating-point type)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 ∧ 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8 ∧ 6 ≤ dtype_(v_3) ∧ dtype_(v_3) ≤ 8 ∧ 6 ≤ dtype_(v_4) ∧ dtype_(v_4) ≤ 8
>>
Rule 7 (df and scale must be strictly positive)
{v_1 : tensor, v_2 : tensor} |= ((∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ min(v_1) > 0) ∧ ((∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 0) ∨ min(v_2) > 0)
>>
Rule 9 (input tensors should have matching dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 10 (input tensor dimension should not exceed 6)
{v_1 : tensor} |= ndim(v_1) ≤ 6
>>
Rule 11 (each dimension of the input tensor must be greater than 0)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
