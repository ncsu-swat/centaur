{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 8 ∧ dtype_(v_2) ≥ 6 ∧ dtype_(v_2) ≤ 8 ∧ dtype_(v_3) ≥ 6 ∧ dtype_(v_3) ≤ 8
