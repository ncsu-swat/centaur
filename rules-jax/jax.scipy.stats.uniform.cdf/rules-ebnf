>>
Rule 1 (tensor x and loc should have the same data type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (tensor loc and scale should have the same data type)
{v_2 : tensor, v_3 : tensor} |= dtype_(v_2) = dtype_(v_3)
>>
Rule 3 (broadcasting compatibility between x and loc)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then (∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1))
>>
Rule 4 (broadcasting compatibility between loc and scale)
{v_2 : tensor, v_3 : tensor} |= if ndim(v_2) = ndim(v_3) then (∀i ∈ [0, ndim(v_2) - 1] : (shape(v_2, i) = shape(v_3, i) ∨ shape(v_2, i) = 1 ∨ shape(v_3, i) = 1))
