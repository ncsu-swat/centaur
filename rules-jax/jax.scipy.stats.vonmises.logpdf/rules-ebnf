Rule 1 (kappa parameter must be non-negative for scalar inputs)
{v_1 : int ⊎ float} |= v_1 ≥ 0
>>
Rule 2 (kappa parameter must have non-negative elements for tensor inputs)
{v_1 : tensor} |= min(v_1) ≥ 0
>>
Rule 3 (the input tensor x must be of a floating-point type)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 4 (if x and kappa are tensors of the same rank, their shapes must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 5 (kappa must be non-negative when it is a float)
{v_1 : float} |= v_1 ≥ 0
>>
Rule 7 (x and kappa must both have floating point types when they are tensors)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 9 (both x and kappa tensors must have non-empty dimensions)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
